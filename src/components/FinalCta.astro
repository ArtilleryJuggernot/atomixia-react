---
import { site } from '../lib/site';
---

<section class="final-cta-shell px-5 sm:px-8" data-final-cta aria-labelledby="final-cta-title">
  <div class="final-cta mx-auto max-w-6xl">
    <p class="meta text-gold-400">Votre projet</p>
    <h2 id="final-cta-title" class="display mt-4 text-4xl text-balance sm:text-5xl">
      Parlons de ce que vous voulez simplifier.
    </h2>
    <div class="final-cta-actions">
      <a class="btn btn-gold" href="/contact">{site.quoteCta}</a>
      <a class="btn btn-ghost" href={`tel:${site.phoneTel}`}>Appeler · {site.phoneDisplay}</a>
    </div>
    <p class="final-cta-note">Gratuit, sans engagement · Réponse sous {site.response}</p>
  </div>
</section>
