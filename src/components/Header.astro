---
import Mark from './Mark.astro';
import { nav, navGroups } from '../lib/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
function active(href: string) {
  const clean = href.split('#')[0] || '/';
  if (href.includes('#')) return false;
  if (clean === '/') return path === '/';
  return path === clean || path.startsWith(`${clean}/`);
}

const links = [
  { href: navGroups[0].items[0].href, label: 'Automatisation' },
  { href: navGroups[0].items[1].href, label: 'Logiciels' },
  { href: navGroups[1].items[0].href, label: 'Conseil SI' },
  { href: navGroups[1].items[1].href, label: 'Cybersécurité' },
  ...nav,
];
---

<header id="site-header" class="z-40 border-b border-gold-400/20 bg-ink-950/95 backdrop-blur-md">
  <div class="header-row mx-auto max-w-6xl px-5 py-3 sm:px-8">
    <a href="/" class="brand-lockup text-parchment" aria-label="Atomixia, accueil">
      <span class="brand-mark">
        <Mark />
      </span>
      <span class="chrome font-display text-sm tracking-[0.22em] sm:text-base">ATOMIXIA</span>
    </a>
    <nav class="nav-bar" aria-label="Navigation principale">
      {
        links.map((item) => (
          <a href={item.href} aria-current={active(item.href) ? 'page' : undefined} class="nav-link">
            {item.label}
          </a>
        ))
      }
      <a class="btn btn-gold nav-cta" href="/contact">Parler de mon projet</a>
    </nav>
  </div>
</header>
