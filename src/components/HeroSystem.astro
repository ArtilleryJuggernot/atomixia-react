---
---

<div class="hero-system">
  <div class="hero-system-glow" aria-hidden="true"></div>
  <svg class="hero-system-net" viewBox="0 0 640 560" aria-hidden="true">
    <g fill="none" stroke="rgba(75,225,236,0.45)" stroke-width="1">
      <path d="M86 150 H250" />
      <path d="M250 150 C310 150 330 210 390 248" />
      <path d="M120 390 H280" />
      <path d="M280 390 C340 390 360 320 430 300" />
      <path d="M470 160 V250" />
    </g>
    <g fill="#4be1ec">
      <circle cx="86" cy="150" r="3" />
      <circle cx="250" cy="150" r="3" />
      <circle cx="390" cy="248" r="3.5" />
      <circle cx="120" cy="390" r="3" />
      <circle cx="430" cy="300" r="3" />
      <circle cx="470" cy="160" r="3" />
    </g>
  </svg>

  <article class="hero-pane pane-build glass-2">
    <p class="meta text-cyan-flux">Build</p>
    <p class="mt-3 font-display text-xl tracking-tight">Logiciel</p>
    <ul class="mt-4 space-y-2 text-sm text-parchment-dim">
      <li>Site métier</li>
      <li>SaaS</li>
      <li>Application</li>
    </ul>
  </article>

  <article class="hero-pane pane-flow glass-3">
    <p class="meta text-cyan-flux">Automate</p>
    <ol class="mt-4 space-y-3 text-sm">
      <li class="flex items-center justify-between gap-3">
        <span>Tâche reçue</span>
        <span class="meta text-parchment-dim">01</span>
      </li>
      <li class="flex items-center justify-between gap-3">
        <span>Agent</span>
        <span class="meta text-cyan-flux">Actif</span>
      </li>
      <li class="flex items-center justify-between gap-3">
        <span>Résultat</span>
        <span class="meta text-parchment-dim">À valider</span>
      </li>
    </ol>
  </article>

  <article class="hero-pane pane-secure glass-1">
    <p class="meta text-cyan-flux">Secure</p>
    <p class="mt-2 font-display text-lg tracking-tight">Accès, traces, décision.</p>
  </article>
</div>
