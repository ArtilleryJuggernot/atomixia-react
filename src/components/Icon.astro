---
interface Props {
  name: 'layers' | 'nodes' | 'shield' | 'core';
  size?: number;
}

const { name, size = 22 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === 'layers' && (
      <>
        <path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.91a1 1 0 0 0 0-1.83Z" />
        <path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65" />
        <path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65" />
      </>
    )
  }
  {
    name === 'nodes' && (
      <>
        <circle cx="6" cy="6" r="2" />
        <circle cx="18" cy="12" r="2" />
        <circle cx="6" cy="18" r="2" />
        <path d="M8 7.2c2.2 1.2 4.6 2.6 8 4.2" />
        <path d="M8 16.8c2.4-.8 5.2-2.2 8-4.2" />
      </>
    )
  }
  {
    name === 'shield' && (
      <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.68-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
    )
  }
  {
    name === 'core' && (
      <>
        <circle cx="12" cy="12" r="2.25" />
        <path d="M12 3.5v2.2" />
        <path d="M12 18.3v2.2" />
        <path d="M3.5 12h2.2" />
        <path d="M18.3 12h2.2" />
        <circle cx="12" cy="12" r="7.25" />
      </>
    )
  }
</svg>
