---
interface Step {
  index: string;
  title: string;
  text: string;
}
interface Props {
  steps: Step[];
  headingLevel?: 'h3' | 'strong';
}
const { steps, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<ol class="light-line" data-light-line data-count={steps.length}>
  <span class="light-line-fill" aria-hidden="true"></span>
  {
    steps.map((step) => {
      const name = step.title.toLocaleLowerCase('fr');
      return (
        <li class="light-step" data-light-step>
          <span class="light-kicker">
            <span class="meta">{step.index}</span>
            <span class="light-ico" aria-hidden="true">
              {name === 'comprendre' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2.5 12S6.2 6.5 12 6.5 21.5 12 21.5 12 17.8 17.5 12 17.5 2.5 12 2.5 12" />
                  <circle cx="12" cy="12" r="2.5" />
                </svg>
              )}
              {name === 'concevoir' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 20h4L19 9l-4-4L4 16v4Z" />
                  <path d="m13.5 6.5 4 4" />
                </svg>
              )}
              {name === 'construire' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3.5" y="13" width="7.2" height="7.2" rx="1.2" />
                  <rect x="13.3" y="13" width="7.2" height="7.2" rx="1.2" />
                  <rect x="8.4" y="3.8" width="7.2" height="7.2" rx="1.2" />
                </svg>
              )}
              {name === 'intégrer' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                  <circle cx="7" cy="12" r="2.4" />
                  <circle cx="17" cy="7" r="2.4" />
                  <circle cx="17" cy="17" r="2.4" />
                  <path d="M9.2 11.1 14.7 8.1M9.2 12.9l5.5 3" />
                </svg>
              )}
              {name === 'mesurer' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                  <path d="M5 19V5M5 19h14" />
                  <path d="M9 15v-4M13 15V8M17 15v-6" />
                </svg>
              )}
              {name === 'améliorer' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                  <path d="M4 8h16M4 16h16" />
                  <circle cx="9" cy="8" r="2.1" />
                  <circle cx="15" cy="16" r="2.1" />
                </svg>
              )}
            </span>
          </span>
          <Heading>{step.title}</Heading>
          <p>{step.text}</p>
        </li>
      );
    })
  }
</ol>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const lines = document.querySelectorAll<HTMLElement>('[data-light-line]');

  if (reduce) {
    lines.forEach((line) => line.querySelectorAll('[data-light-step]').forEach((step) => step.classList.add('is-lit')));
  } else if (lines.length) {
    gsap.registerPlugin(ScrollTrigger);
    const horizontal = window.matchMedia('(min-width: 900px)').matches;
    lines.forEach((line) => {
      const fill = line.querySelector<HTMLElement>('.light-line-fill');
      const steps = Array.from(line.querySelectorAll<HTMLElement>('[data-light-step]'));
      if (!fill) return;
      gsap.to(fill, {
        [horizontal ? 'scaleX' : 'scaleY']: 1,
        ease: 'none',
        scrollTrigger: {
          trigger: line,
          start: 'top 78%',
          end: horizontal ? 'center 60%' : 'center 70%',
          scrub: 0.5,
          onUpdate: (self) => {
            const count = Math.round(self.progress * steps.length + 0.25);
            steps.forEach((step, index) => step.classList.toggle('is-lit', index < count));
          },
        },
      });
    });
  }
</script>
