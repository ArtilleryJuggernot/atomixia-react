---
/** Authorized-scope visual for the cybersecurity pages: three reading modes. */
const modes = [
  {
    id: 'audit',
    label: 'Audit',
    title: 'Audit de sécurité',
    text: 'On décrit l’organisation, les accès, les règles et les flux. Rien n’est attaqué. Le livrable est une lecture de la posture.',
  },
  {
    id: 'vuln',
    label: 'Analyse de vulnérabilités',
    title: 'Analyse de vulnérabilités',
    text: 'On liste les faiblesses connues sur les éléments du périmètre : versions, configurations, services exposés. Les constats sont classés.',
  },
  {
    id: 'pentest',
    label: 'Test d’intrusion',
    title: 'Test d’intrusion autorisé',
    text: 'On tente d’exploiter les faiblesses, dans le périmètre écrit et pendant la fenêtre convenue. Ce qui est hors périmètre n’est pas touché.',
  },
];
---

<div class="perimeter tone-amber" data-perimeter>
  <div class="perimeter-board panel" data-mode="audit">
    <svg viewBox="0 0 320 220" role="img" aria-labelledby="perimeter-title perimeter-desc">
      <title id="perimeter-title">Périmètre autorisé</title>
      <desc id="perimeter-desc">
        Un cadre en pointillés délimite le périmètre autorisé : portail client, API, authentification, base de données. À l’extérieur, un
        poste comptable et un prestataire tiers ne sont pas testés.
      </desc>
      <defs>
        <linearGradient id="scan-gradient" x1="0" x2="1">
          <stop offset="0" stop-color="#e8b86d" stop-opacity="0" />
          <stop offset="0.5" stop-color="#e8b86d" stop-opacity="0.18" />
          <stop offset="1" stop-color="#e8b86d" stop-opacity="0" />
        </linearGradient>
        <clipPath id="scope-clip"><rect x="18" y="26" width="206" height="176" rx="12" /></clipPath>
      </defs>

      <rect class="scope-rect" x="18" y="26" width="206" height="176" rx="12" />
      <text class="scope-label" x="26" y="20">Périmètre autorisé · écrit · daté</text>

      <g clip-path="url(#scope-clip)">
        <rect class="scan" x="18" y="26" width="90" height="176" />
      </g>

      <line class="flow" x1="80" y1="86" x2="150" y2="86" />
      <line class="flow" x1="150" y1="86" x2="150" y2="140" />
      <line class="flow" x1="80" y1="86" x2="80" y2="150" />
      <line class="flow" x1="150" y1="150" x2="80" y2="150" />

      <rect class="asset a-portal" x="40" y="62" width="80" height="44" rx="8" />
      <text class="asset-label" x="50" y="80">Portail client</text>
      <text class="asset-label" x="50" y="94">HTTPS · public</text>

      <rect class="asset a-api" x="130" y="62" width="76" height="44" rx="8" />
      <text class="asset-label" x="140" y="80">API</text>
      <text class="asset-label" x="140" y="94">REST · jetons</text>

      <rect class="asset a-auth" x="40" y="128" width="80" height="44" rx="8" />
      <text class="asset-label" x="50" y="146">Authentification</text>
      <text class="asset-label" x="50" y="160">Comptes · rôles</text>

      <rect class="asset a-db" x="130" y="128" width="76" height="44" rx="8" />
      <text class="asset-label" x="140" y="146">Base de données</text>
      <text class="asset-label" x="140" y="160">Interne</text>

      <g class="finding f-high">
        <circle cx="120" cy="62" r="9" />
        <text x="134" y="56">Élevé</text>
      </g>
      <g class="finding f-mid">
        <circle cx="206" cy="128" r="9" />
        <text x="196" y="188">Moyen</text>
      </g>
      <g class="finding f-ok">
        <circle cx="40" cy="172" r="9" />
        <text x="28" y="194">Corrigé</text>
      </g>

      <rect class="asset asset-out" x="246" y="62" width="60" height="44" rx="8" />
      <text class="asset-label asset-out-label" x="254" y="80">Poste compta</text>
      <text class="asset-label asset-out-label" x="254" y="94">Hors périmètre</text>

      <rect class="asset asset-out" x="246" y="128" width="60" height="44" rx="8" />
      <text class="asset-label asset-out-label" x="254" y="146">Prestataire</text>
      <text class="asset-label asset-out-label" x="254" y="160">Non testé</text>
    </svg>
  </div>
  <aside class="panel node-detail" aria-live="polite">
    <div class="mode-switch" role="group" aria-label="Type de prestation">
      {
        modes.map((mode, index) => (
          <button type="button" class="mode-btn" data-mode-btn={mode.id} aria-pressed={index === 0 ? 'true' : 'false'}>
            {mode.label}
          </button>
        ))
      }
    </div>
    {
      modes.map((mode, index) => (
        <div data-mode-panel={mode.id} hidden={index !== 0}>
          <p class="mt-6 font-display text-2xl tracking-tight">{mode.title}</p>
          <p class="mt-3 text-parchment-dim">{mode.text}</p>
        </div>
      ))
    }
    <ul class="mt-6">
      <li>Autorisation écrite du responsable du système avant tout test.</li>
      <li>Les éléments hors périmètre restent intouchés.</li>
      <li>Le rapport classe les constats par risque. Il n’est pas une garantie.</li>
    </ul>
  </aside>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-perimeter]').forEach((root) => {
    const board = root.querySelector<HTMLElement>('.perimeter-board');
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-mode-btn]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-mode-panel]'));
    if (!board) return;
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const mode = button.dataset.modeBtn!;
        board.dataset.mode = mode;
        buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.modePanel !== mode;
        });
      });
    });
  });
</script>
