---
interface Props {
  kind: 'automation' | 'software' | 'systems' | 'cyber';
  class?: string;
}
const { kind, class: className = '' } = Astro.props;
const gradientId = `pb-${kind}`;
const stops: Record<Props['kind'], [string, string, string]> = {
  automation: ['#5df2ff', '#00ddf5', '#06283a'],
  software: ['#f7e4b5', '#d9c18a', '#3c2e20'],
  systems: ['#e8edf3', '#8e9bb0', '#1a2230'],
  cyber: ['#4a5261', '#1a1f28', '#07090d'],
};
const [c1, c2, c3] = stops[kind];
---

<div class:list={['planet-badge', className]} aria-hidden="true">
  <svg viewBox="0 0 200 200">
    <defs>
      <radialGradient id={gradientId} cx="36%" cy="32%" r="70%">
        <stop offset="0%" stop-color={c1} />
        <stop offset="45%" stop-color={c2} />
        <stop offset="100%" stop-color={c3} />
      </radialGradient>
      <radialGradient id={`${gradientId}-glow`} cx="50%" cy="50%" r="50%">
        <stop offset="60%" stop-color={c2} stop-opacity="0.22" />
        <stop offset="100%" stop-color={c2} stop-opacity="0" />
      </radialGradient>
    </defs>
    <circle cx="100" cy="100" r="98" fill={`url(#${gradientId}-glow)`} />
    {
      kind === 'automation' && (
        <>
          <ellipse class="pb-ring" cx="100" cy="100" rx="86" ry="26" />
          <ellipse class="pb-ring r2" cx="100" cy="100" rx="74" ry="40" transform="rotate(-28 100 100)" />
          <circle cx="100" cy="100" r="44" fill={`url(#${gradientId})`} />
          <circle class="pb-sat" cx="186" cy="100" r="2.6" />
          <circle class="pb-sat s2" cx="26" cy="100" r="2" />
          <circle class="pb-sat s3" cx="100" cy="34" r="2.2" />
        </>
      )
    }
    {
      kind === 'software' && (
        <>
          <circle cx="100" cy="100" r="46" fill={`url(#${gradientId})`} />
          <g class="pb-grid">
            <polygon points="100,34 157,67 157,133 100,166 43,133 43,67" />
            <polygon points="100,34 157,133 43,133" />
            <polygon points="100,166 43,67 157,67" />
          </g>
          <rect class="pb-sat" x="160" y="58" width="6" height="6" />
          <rect class="pb-sat s2" x="34" y="130" width="5" height="5" />
          <rect class="pb-sat s3" x="150" y="150" width="4" height="4" />
        </>
      )
    }
    {
      kind === 'systems' && (
        <>
          <circle cx="100" cy="100" r="40" fill={`url(#${gradientId})`} />
          <g class="pb-grid">
            <path d="M100 30 L160 70 L160 130 L100 170 L40 130 L40 70 Z" />
            <path d="M100 30 L100 170 M40 70 L160 130 M160 70 L40 130" />
          </g>
          <g fill="#00ddf5">
            <circle cx="100" cy="30" r="3" />
            <circle cx="160" cy="70" r="3" />
            <circle cx="160" cy="130" r="3" />
            <circle cx="100" cy="170" r="3" />
            <circle cx="40" cy="130" r="3" />
            <circle cx="40" cy="70" r="3" />
          </g>
        </>
      )
    }
    {
      kind === 'cyber' && (
        <>
          <ellipse class="pb-ring" cx="100" cy="108" rx="78" ry="26" />
          <path class="pb-shield" d="M76 104V82a24 24 0 0 1 48 0v22" />
          <rect x="64" y="98" width="72" height="56" rx="12" fill={`url(#${gradientId})`} stroke="#e8b86d" stroke-width="1.6" />
          <circle class="pb-pulse" cx="100" cy="120" r="7" fill="#e8b86d" />
          <path class="pb-alert" d="M100 127v14" />
        </>
      )
    }
  </svg>
</div>
