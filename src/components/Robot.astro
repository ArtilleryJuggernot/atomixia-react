---
interface Props {
  label?: string;
}

const { label = 'Agent géométrique' } = Astro.props;
---

<svg class="robot" viewBox="0 0 160 180" role="img" aria-label={label}>
  <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path class="robot-antenna" d="M80 18 V36" />
    <circle cx="80" cy="14" r="4" fill="currentColor" stroke="none" />
    <rect x="28" y="36" width="104" height="78" rx="16" />
    <path d="M28 62 H132" />
    <circle class="robot-eye" cx="62" cy="82" r="6" />
    <circle class="robot-eye" cx="98" cy="82" r="6" />
    <path d="M58 98 H102" />
    <path d="M48 114 H18" />
    <path d="M112 114 H142" />
    <rect x="46" y="122" width="68" height="36" rx="10" />
    <path d="M68 140 H92" />
    <path d="M58 158 H46" />
    <path d="M114 158 H102" />
  </g>
  <polygon points="80,48 86,58 74,58" fill="currentColor" opacity="0.85" />
</svg>
