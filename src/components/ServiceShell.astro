---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Breadcrumb from './Breadcrumb.astro';
import PlanetBadge from './PlanetBadge.astro';
import Icon from './Icon.astro';
import type { Service } from '../lib/services';
import { serviceList } from '../lib/services';
import { site } from '../lib/site';

interface Props {
  service: Service;
  parent: { name: string; href: string };
  description: string;
  demoTitle: string;
  demoText: string;
}
const { service, parent, description, demoTitle, demoText } = Astro.props;
const others = serviceList.filter((item) => item.id !== service.id);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: service.name,
    serviceType: service.label,
    provider: { '@id': `${site.url}/#organization` },
    areaServed: site.region,
    description,
    url: `${site.url}${service.href}`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: service.faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
];
---

<Base title={`${service.pageTitle} — Atomixia`} description={description} path={service.href} jsonLd={jsonLd}>
  <Header />
  <main id="contenu" class={`tone-${service.tone}`}>
    <section class="service-hero px-5 pb-12 sm:px-8" aria-labelledby="service-title">
      <div class="mx-auto max-w-6xl">
        <Breadcrumb items={[{ name: 'Accueil', href: '/' }, parent, { name: service.short, href: service.href }]} />
        <div class="mt-10 grid items-center gap-10 lg:grid-cols-12">
          <div class="lg:col-span-7">
            <p class="meta tone-text">{service.index} — {service.label}</p>
            <h1 id="service-title" class="display mt-5 text-[clamp(2.4rem,5vw,4.4rem)] text-balance">
              {service.name}<br />
              <span class="tone-text">{service.headline}</span>
            </h1>
            <p class="mt-6 max-w-2xl text-lg text-parchment-dim">{service.lede}</p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a class="btn btn-gold" href="/contact" data-cursor="Écrire">{service.cta}</a>
              <a class="btn btn-ghost" href="#demo" data-cursor="Descendre">Voir la visualisation</a>
            </div>
          </div>
          <div class="lg:col-span-5">
            <slot name="visual">
              <PlanetBadge kind={service.id} />
            </slot>
          </div>
        </div>
      </div>
    </section>

    <section class="px-5 py-14 sm:px-8" aria-labelledby="probleme-title">
      <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="meta tone-text">Le problème</p>
          <h2 id="probleme-title" class="editorial mt-4">{service.problem}</h2>
        </div>
        <div class="lg:col-span-7">
          <p class="meta tone-text">Pour qui</p>
          <ul class="mt-4 grid gap-3">
            {
              service.audiences.map((audience) => (
                <li class="flex gap-3 border-t border-line/80 pt-3 text-parchment-dim">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--tone)]" aria-hidden="true" />
                  {audience}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <section id="demo" class="px-5 py-14 sm:px-8" aria-labelledby="demo-title">
      <div class="mx-auto max-w-6xl">
        <div class="section-head">
          <div>
            <p class="section-index meta">Visualisation</p>
            <h2 id="demo-title" class="display mt-4 text-4xl text-balance sm:text-5xl">{demoTitle}</h2>
          </div>
          <p class="text-parchment-dim">{demoText}</p>
        </div>
        <div class="mt-10">
          <slot name="demo" />
        </div>
      </div>
    </section>

    <section class="px-5 py-14 sm:px-8" aria-labelledby="livre-title">
      <div class="mx-auto max-w-6xl">
        <p class="section-index meta">Ce que nous livrons</p>
        <h2 id="livre-title" class="display mt-4 max-w-3xl text-4xl text-balance sm:text-5xl">Des cas d’usage concrets.</h2>
        <ul class="check-list mt-10">
          {
            service.delivers.map((item) => (
              <li>
                <Icon name="check" size={18} />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="px-5 py-14 sm:px-8" aria-labelledby="engagement-title">
      <div class="mx-auto max-w-6xl">
        <p class="section-index meta">Déroulé d’une mission</p>
        <h2 id="engagement-title" class="display mt-4 max-w-3xl text-4xl text-balance sm:text-5xl">Comment on commence.</h2>
        <ol class="step-grid mt-10">
          {
            service.engagement.map((step, index) => (
              <li class="step-card">
                <p class="meta">0{index + 1}</p>
                <p class="mt-3 font-display text-xl tracking-tight">{step.title}</p>
                <p class="mt-2 text-sm text-parchment-dim">{step.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="px-5 py-14 sm:px-8" aria-labelledby="livrables-title">
      <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="section-index meta">Livrables</p>
          <h2 id="livrables-title" class="display mt-4 text-4xl text-balance">Ce qui reste entre vos mains.</h2>
          <ul class="mt-8 grid gap-3">
            {
              service.deliverables.map((item) => (
                <li class="panel px-4 py-3 text-parchment">{item}</li>
              ))
            }
          </ul>
        </div>
        <div class="lg:col-span-7">
          <p class="section-index meta">Détails techniques</p>
          <h2 class="display mt-4 text-4xl text-balance">Les règles écrites.</h2>
          <ul class="tech-list mt-8">{service.technical.map((item) => <li>{item}</li>)}</ul>
        </div>
      </div>
    </section>

    <section class="px-5 py-14 sm:px-8" aria-labelledby="faq-title">
      <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="section-index meta">Questions</p>
          <h2 id="faq-title" class="display mt-4 text-4xl text-balance">Avant de commencer.</h2>
        </div>
        <div class="faq lg:col-span-8">
          {
            service.faqs.map((faq) => (
              <details>
                <summary>{faq.question}</summary>
                <p>{faq.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="px-5 py-14 sm:px-8" aria-labelledby="suite-title">
      <div class="mx-auto max-w-6xl">
        <div class="cta-stellar">
          <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
            <div class="lg:col-span-7">
              <p class="meta text-gold-400">Prochaine étape</p>
              <h2 id="suite-title" class="display mt-4 text-4xl text-balance sm:text-5xl">
                Et si votre prochain avantage était déjà à portée de main ?
              </h2>
              <p class="mt-4 max-w-xl text-parchment-dim">Décrivez la situation en quelques lignes. Réponse sous {site.response}.</p>
              <a class="btn btn-gold mt-8" href="/contact" data-cursor="Écrire">{service.cta}</a>
            </div>
            <div class="lg:col-span-5">
              <p class="meta text-subtle">Les autres capacités</p>
              <ul class="mt-3 grid gap-2">
                {
                  others.map((other) => (
                    <li>
                      <a class={`flex items-center justify-between gap-3 rounded-xl border border-line/80 px-4 py-3 text-parchment hover:border-gold-400/60 tone-${other.tone}`} href={other.href}>
                        <span><span class="meta tone-text">{other.index}</span> <span class="ml-2 font-display">{other.label}</span></span>
                        <span aria-hidden="true">→</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
