---
interface Stage {
  index: string;
  title: string;
  text: string;
}
interface Props {
  stages: Stage[];
}
const { stages } = Astro.props;
---

<ol class="stages" data-reveal data-stages>
  {
    stages.map((stage) => {
      const name = stage.title.toLocaleUpperCase('fr');
      return (
        <li class="stage">
          <span class="stage-kicker">
            <span class="meta">{stage.index}</span>
            <span class="stage-ico" aria-hidden="true">
              {name === 'AUDIT' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="7" y="4.2" width="10" height="16" rx="1.6" />
                  <path d="M9.5 4.2V3.2A1.2 1.2 0 0 1 10.7 2h2.6a1.2 1.2 0 0 1 1.2 1.2v1" />
                  <path d="M9.5 9.5h5M9.5 13h5M9.5 16.5h3.2" />
                </svg>
              )}
              {name === 'ARCHITECTURE' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="7" cy="7" r="2.1" />
                  <circle cx="17" cy="7" r="2.1" />
                  <circle cx="12" cy="17" r="2.1" />
                  <path d="M9.1 7h5.8M8.6 8.6l2.2 6.2M15.4 8.6l-2.2 6.2" />
                </svg>
              )}
              {name === 'PRIORISATION' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                  <path d="M4.5 7h15" />
                  <path d="M4.5 12h10" />
                  <path d="M4.5 17h6" />
                </svg>
              )}
              {name === 'IMPLÉMENTATION' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3.5" y="3.5" width="7.4" height="7.4" rx="1.2" />
                  <rect x="13.1" y="3.5" width="7.4" height="7.4" rx="1.2" />
                  <rect x="8.3" y="13.1" width="7.4" height="7.4" rx="1.2" />
                </svg>
              )}
              {name === 'OPTIMISATION' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                  <path d="M4 8h16" />
                  <path d="M4 16h16" />
                  <circle cx="9" cy="8" r="2.15" />
                  <circle cx="15" cy="16" r="2.15" />
                </svg>
              )}
            </span>
          </span>
          <strong>{stage.title}</strong>
          <p>{stage.text}</p>
        </li>
      );
    })
  }
</ol>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const lists = document.querySelectorAll<HTMLElement>('[data-stages]');
  if (!reduce && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => entry.target.classList.toggle('is-in', entry.isIntersecting));
    });
    lists.forEach((list) => observer.observe(list));
  }
</script>
