---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { site } from '../lib/site';

const about = await getEntry('about', 'page');
if (!about) throw new Error('Page à propos manquante');
const description = 'Atomixia, entreprise fondée par Hugo Jacquel à Lyon. Agents IA, développement, cybersécurité et automatisation en Auvergne-Rhône-Alpes.';
---

<Base title="À propos — Atomixia" description={description} path="/a-propos">
  <Header />
  <main id="contenu" class="px-5 pt-28 pb-24 sm:px-8">
    <article class="mx-auto max-w-6xl">
      <Breadcrumb items={[{ name: 'Accueil', href: '/' }, { name: 'À propos', href: '/a-propos' }]} />
      <div class="mt-10 grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="meta">{site.city}</p>
          <h1 class="display mt-4 text-5xl sm:text-6xl">{about.data.title}</h1>
          <hr class="gold-rule" />
          <p class="editorial mt-8">{about.data.editorial}</p>
          <div class="mt-8 space-y-4 text-parchment-dim">
            {about.data.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          <a class="btn btn-ghost mt-8" href={site.portfolio} rel="noopener noreferrer">Portfolio de Hugo Jacquel</a>
        </div>
        <dl class="space-y-6 lg:col-span-4 lg:col-start-9 lg:pt-20">
          <div>
            <dt class="meta">Fondateur</dt>
            <dd class="mt-1">{site.founder}</dd>
          </div>
          <div>
            <dt class="meta">Zone</dt>
            <dd class="mt-1">{site.city} · {site.region}</dd>
          </div>
          <div>
            <dt class="meta">Contact</dt>
            <dd class="mt-1">
              <a class="hover:text-gold-300" href={`mailto:${site.email}`}>{site.email}</a>
            </dd>
          </div>
        </dl>
      </div>
    </article>
  </main>
  <Footer />
</Base>
