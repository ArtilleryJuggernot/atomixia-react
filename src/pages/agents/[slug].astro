---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { site } from '../../lib/site';

export async function getStaticPaths() {
  const agents = await getCollection('agents');
  return agents.map((agent) => ({
    params: { slug: agent.id },
    props: { agent },
  }));
}

interface Props {
  agent: CollectionEntry<'agents'>;
}

const { agent } = Astro.props;
const data = agent.data;
const others = (await getCollection('agents'))
  .filter((item) => item.id !== agent.id)
  .sort((a, b) => a.data.order - b.data.order);

const canonicalPath = `/agents/${agent.id}`;
const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: data.title,
  serviceType: data.role,
  description: data.short,
  url: new URL(canonicalPath, site.url).toString(),
  provider: { '@id': `${site.url}/#organization` },
  areaServed: site.region,
};
const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: data.faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<Base title={`${data.title} — Atomixia`} description={data.short} path={canonicalPath} jsonLd={[service, faq]}>
  <Header />
  <main id="contenu" class="px-5 pt-28 pb-24 sm:px-8">
    <article class="mx-auto max-w-6xl">
      <Breadcrumb
        items={[
          { name: 'Accueil', href: '/' },
          { name: 'Agents', href: '/agents' },
          { name: data.navTitle, href: canonicalPath },
        ]}
      />

      <header class="mt-10 grid gap-8 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <p class="meta">{data.transversal ? 'Transversal' : `Agent 0${data.order}`}</p>
          <h1 class="display mt-4 text-5xl text-pretty sm:text-6xl">{data.title}</h1>
          <hr class="gold-rule" />
          <p class="editorial mt-8 max-w-2xl">{data.editorial}</p>
        </div>
      </header>

      <section class="mt-16 grid gap-8 lg:grid-cols-12" aria-labelledby="situation">
        <h2 id="situation" class="meta lg:col-span-3">Situation</h2>
        <p class="text-xl leading-relaxed text-parchment lg:col-span-8">{data.situation}</p>
      </section>

      <section class="mt-16 grid gap-12 border-t border-parchment/10 pt-12 lg:grid-cols-2" aria-labelledby="fait">
        <div>
          <h2 id="fait" class="font-display text-3xl tracking-tight">Ce que l’agent fait</h2>
          <ul class="mt-6 space-y-4">
            {data.does.map((item, index) => (
              <li class="grid grid-cols-[2.5rem_1fr] gap-3 border-t border-parchment/10 pt-4">
                <span class="meta text-gold-400">{String(index + 1).padStart(2, '0')}</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="font-display text-3xl tracking-tight">Ce qu’il ne fait jamais seul</h2>
          <ul class="mt-6 space-y-4">
            {data.neverAlone.map((item) => (
              <li class="border-t border-gold-500/30 pt-4 text-parchment-dim">{item}</li>
            ))}
          </ul>
        </div>
      </section>

      <section class="mt-16 border-t border-parchment/10 pt-10" aria-labelledby="outils">
        <h2 id="outils" class="meta">Outils concernés</h2>
        <ul class="mt-5 flex flex-wrap gap-x-6 gap-y-3">
          {data.tools.map((tool) => (
            <li class="font-mono text-sm tracking-wide text-parchment">{tool}</li>
          ))}
        </ul>
      </section>

      <section class="mt-16 grid gap-6 border-t border-parchment/10 pt-10 lg:grid-cols-12" aria-labelledby="resultat">
        <h2 id="resultat" class="meta lg:col-span-3">Résultat attendu</h2>
        <p class="font-display text-3xl tracking-tight lg:col-span-8">{data.result}</p>
      </section>

      <section class="mt-16" aria-labelledby="garde-fous">
        <h2 id="garde-fous" class="font-display text-3xl tracking-tight">Garde-fous</h2>
        <ol class="mt-6">
          {data.safeguards.map((item, index) => (
            <li class="grid grid-cols-[3rem_1fr] gap-4 border-t border-parchment/10 py-4">
              <span class="meta text-gold-400">{String(index + 1).padStart(2, '0')}</span>
              <span class="text-parchment-dim">{item}</span>
            </li>
          ))}
        </ol>
      </section>

      <section class="mt-16" aria-labelledby="faq">
        <h2 id="faq" class="font-display text-3xl tracking-tight">Questions fréquentes</h2>
        <div class="mt-6 divide-y divide-parchment/10 border-y border-parchment/10">
          {data.faqs.map((item) => (
            <details class="group py-4">
              <summary class="cursor-pointer list-none font-display text-lg tracking-tight marker:content-none [&::-webkit-details-marker]:hidden">
                <span class="flex items-start justify-between gap-6">
                  {item.question}
                  <span class="meta text-gold-400 group-open:hidden" aria-hidden="true">Ouvrir</span>
                  <span class="meta hidden text-gold-400 group-open:inline" aria-hidden="true">Fermer</span>
                </span>
              </summary>
              <p class="mt-3 max-w-3xl text-parchment-dim">{item.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="mt-16 grid gap-8 border-t border-gold-500/30 pt-10 lg:grid-cols-12" aria-labelledby="suite">
        <div class="lg:col-span-7">
          <h2 id="suite" class="display text-4xl">Repérer ce processus</h2>
          <p class="mt-4 max-w-xl text-parchment-dim">
            Un échange pour voir si cet agent a une place dans votre semaine, et ce qui doit rester une décision humaine.
          </p>
          <a class="btn btn-gold mt-6" href="/contact">Décrire mon processus</a>
        </div>
        <div class="lg:col-span-4 lg:col-start-9">
          <p class="meta">Autres agents</p>
          <ul class="mt-4 space-y-2">
            {others.map((item) => (
              <li>
                <a class="text-parchment-dim hover:text-parchment" href={`/agents/${item.id}`}>{item.data.navTitle}</a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </article>
  </main>
  <Footer />
</Base>
