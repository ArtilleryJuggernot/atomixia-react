---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ContactForm from '../components/islands/ContactForm';
import { site } from '../lib/site';

const description = `Demandez un devis gratuit. Atomixia répond sous ${site.response}, depuis Lyon.`;
---

<Base title="Contact — Atomixia" description={description} path="/contact">
  <Header />
  <main id="contenu" class="px-5 pt-28 pb-24 sm:px-8">
    <div class="mx-auto grid max-w-6xl gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <Breadcrumb items={[{ name: 'Accueil', href: '/' }, { name: 'Contact', href: '/contact' }]} />
        <h1 class="display mt-10 text-5xl sm:text-6xl">Demandez votre <em>devis gratuit.</em></h1>
        <hr class="gold-rule" />
        <p class="mt-8 text-parchment-dim">
          Décrivez votre projet en quelques lignes. Réponse sous {site.response}, sans engagement.
        </p>
        <ul class="mt-10 space-y-3">
          <li>
            <a class="flex min-h-14 flex-col justify-center border border-gold-300/20 px-5 py-3 hover:border-gold-300/40" href={`tel:${site.phoneTel}`}>
              <span class="meta">Appeler</span>
              <span>{site.phoneDisplay}</span>
            </a>
          </li>
          <li>
            <a class="flex min-h-14 flex-col justify-center border border-gold-300/20 px-5 py-3 hover:border-gold-300/40" href={site.quoteMailto}>
              <span class="meta">Écrire</span>
              <span>{site.email}</span>
            </a>
          </li>
          <li>
            <div class="flex min-h-14 flex-col justify-center border border-gold-300/20 px-5 py-3">
              <span class="meta">Zone</span>
              <span>{site.city} · {site.region}</span>
            </div>
          </li>
        </ul>
      </div>
      <div class="lg:col-span-7">
        <ContactForm client:load />
      </div>
    </div>
  </main>
  <Footer />
</Base>
