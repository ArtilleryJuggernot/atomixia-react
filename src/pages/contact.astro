---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ContactForm from '../components/islands/ContactForm';
import { site } from '../lib/site';

const description = 'Décrivez le processus à automatiser. Atomixia répond sous 24 à 48 h, depuis Lyon.';
---

<Base title="Contact — Atomixia" description={description} path="/contact">
  <Header />
  <main id="contenu" class="px-5 pt-28 pb-24 sm:px-8">
    <div class="mx-auto grid max-w-6xl gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <Breadcrumb items={[{ name: 'Accueil', href: '/' }, { name: 'Contact', href: '/contact' }]} />
        <h1 class="display mt-10 text-5xl sm:text-6xl">Décrire le processus</h1>
        <hr class="gold-rule" />
        <p class="editorial mt-8">Une réponse sous 24 à 48 h.</p>
        <p class="mt-6 text-parchment-dim">
          Nommez le geste qui se répète, l’entreprise, et les outils déjà là. Pas de lettre d’information.
        </p>
        <ul class="mt-10 space-y-5">
          <li>
            <p class="meta">E-mail</p>
            <a class="mt-1 inline-flex hover:text-gold-300" href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>
            <p class="meta">Téléphone</p>
            <a class="mt-1 inline-flex hover:text-gold-300" href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a>
          </li>
          <li>
            <p class="meta">Zone</p>
            <p class="mt-1">{site.city} · {site.region}</p>
          </li>
        </ul>
      </div>
      <div class="lg:col-span-7">
        <ContactForm client:load />
      </div>
    </div>
  </main>
  <Footer />
</Base>
