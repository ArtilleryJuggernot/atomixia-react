---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import OptoutList from '../components/islands/OptoutList';

const description = 'Liste des personnes qui se sont opposées à la prospection Atomixia.';
---

<Base title="Oppositions — Atomixia" description={description} path="/desinscriptions" noindex>
  <Header />
  <main id="contenu" class="px-5 pt-28 pb-24 sm:px-8">
    <div class="mx-auto max-w-6xl">
      <p class="meta">Prospection</p>
      <h1 class="display mt-4 text-5xl sm:text-6xl">Personnes désinscrites</h1>
      <hr class="gold-rule" />
      <p class="mt-8 max-w-2xl text-parchment-dim">
        La liste ne s’affiche qu’avec la clé de lecture. Elle reprend chaque adresse qui a dit stop, pour ne plus la contacter.
      </p>
      <div class="mt-10">
        <OptoutList client:load />
      </div>
    </div>
  </main>
  <Footer />
</Base>
