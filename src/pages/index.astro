---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import Quote from '../components/Quote.astro';
import ContactForm from '../components/islands/ContactForm';
import PhraseCycle from '../components/islands/PhraseCycle';
import SystemScene from '../components/islands/SystemScene';
import TaskMatcher from '../components/islands/TaskMatcher';
import { site } from '../lib/site';

const artemisia = await getEntry('realisations', 'artemisia');
if (!artemisia) throw new Error('Réalisation manquante');

const flows = [
  { index: '01', title: 'Connecter', text: 'Messagerie, dossiers, suivi, facturation : on nomme ce qui existe déjà.' },
  { index: '02', title: 'Automatiser', text: 'Les gestes qui se répètent sont préparés. L’envoi reste une décision.' },
  { index: '03', title: 'Structurer', text: 'Les pièces utiles deviennent un dossier que l’on peut relire.' },
  { index: '04', title: 'Augmenter', text: 'L’équipe garde le jugement. L’agent avance le travail mécanique.' },
  { index: '05', title: 'Relire', text: 'On voit ce qui a été préparé, et ce qu’une personne a validé.' },
];

const solutions = [
  {
    icon: 'bot' as const,
    kicker: '01',
    title: 'Agents IA et automatisation',
    text: 'Trier, préparer, retrouver. L’agent s’arrête là où une personne doit décider.',
    href: '/agents',
    action: 'Voir les agents',
  },
  {
    icon: 'server' as const,
    kicker: '02',
    title: 'Logiciel et intégration',
    text: 'Sites métier, SaaS, outils internes. On relie ce qui existe avant d’en ajouter.',
    href: '/sites',
    action: 'Voir les logiciels',
  },
  {
    icon: 'nodes' as const,
    kicker: '03',
    title: 'Systèmes sur mesure',
    text: 'Quand le métier n’entre dans aucun modèle, le système est dessiné pour lui.',
    href: '/agents/sur-mesure',
    action: 'Décrire le système',
  },
  {
    icon: 'shield' as const,
    kicker: '04',
    title: 'Cybersécurité',
    text: 'Audit du système d’information et pentest, en complément. Le livrable est un rapport de priorités.',
    href: '/securite',
    action: 'Voir la sécurité',
  },
];

const cases = [
  { kicker: 'Exemple', title: 'E-mails à préparer', text: 'La demande est lue, classée, et une réponse est proposée.', href: '/agents/messagerie' },
  { kicker: 'Exemple', title: 'Pièces et factures', text: 'Un document devient un brouillon structuré, encore non émis.', href: '/agents/facturation' },
  { kicker: 'Exemple', title: 'Outils à relier', text: 'Le suivi, les dossiers et la messagerie parlent entre eux.', href: '/sites' },
  { kicker: 'Exemple', title: 'Connaissance interne', text: 'Une question retrouve la pièce qui fait foi.', href: '/agents/connaissance' },
  { kicker: 'Exemple', title: 'Rapport préparé', text: 'Les chiffres déjà saisis sont rassemblés pour une relecture.', href: '/agents/quotidien' },
];

const method = [
  { index: '01', title: 'Découvrir', text: 'On suit le travail réel : un mail, un devis, une pièce introuvable.' },
  { index: '02', title: 'Concevoir', text: 'On nomme les étapes, les outils, et ce qu’un agent peut préparer.' },
  { index: '03', title: 'Construire', text: 'On relie l’existant. S’il manque un logiciel, on le conçoit.' },
  { index: '04', title: 'Déployer', text: 'Rôles, sources, validation. Puis la mise en service.' },
  { index: '05', title: 'Améliorer', text: 'On relit le journal. Si le métier change, le périmètre s’arrête.' },
];
---

<Base title="Atomixia — Systèmes connectés" description={site.description} path="/">
  <Header />
  <main id="contenu">
    <section class="hero-band px-5 pt-28 pb-10 sm:px-8" aria-labelledby="hero-title">
      <div class="mx-auto grid max-w-6xl items-center gap-10 lg:grid-cols-12 lg:gap-8">
        <div class="lg:col-span-5">
          <p class="meta text-cyan-flux">Intelligence connectée</p>
          <h1 id="hero-title" class="display mt-5 text-[clamp(2.6rem,5.4vw,4.6rem)] text-balance">
            Vos systèmes connectés.<br />
            <span class="text-cyan-flux">Votre potentiel augmenté.</span>
          </h1>
          <p class="mt-6 max-w-md text-lg text-parchment-dim">
            Nous concevons des solutions IA et des automatisations qui transforment vos processus en systèmes intelligents.
          </p>
          <p class="phrase-line mt-4">
            <PhraseCycle
              client:visible
              phrases={['Un outil se relie.', 'Un agent prépare.', 'Une personne valide.', 'Le système tient.']}
            />
            <span class="sr-only">Un outil se relie, un agent prépare, une personne valide, le système tient.</span>
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a class="btn btn-flux" href="/contact">Parlons de votre projet</a>
            <a class="btn btn-ghost" href="#solutions">Découvrir nos solutions</a>
          </div>
        </div>
        <div class="lg:col-span-7">
          <SystemScene client:load />
        </div>
      </div>
    </section>

    <section aria-label="Repères" class="px-5 sm:px-8">
      <ul class="mx-auto grid max-w-6xl border-y border-white/10 md:grid-cols-3">
        <li class="border-b border-white/10 px-1 py-6 md:border-b-0 md:px-8">
          <p class="meta">Lieu</p>
          <p class="mt-2 font-display text-2xl tracking-tight">Lyon</p>
          <p class="mt-1 text-sm text-parchment-dim">{site.region}</p>
        </li>
        <li class="border-b border-white/10 px-1 py-6 md:border-x md:border-b-0 md:border-white/10 md:px-8">
          <p class="meta">Réponse</p>
          <p class="mt-2 font-display text-2xl tracking-tight">24 à 48 h</p>
          <p class="mt-1 text-sm text-parchment-dim">Après description du besoin</p>
        </li>
        <li class="px-1 py-6 md:px-8">
          <p class="meta">Produit livré</p>
          <p class="mt-2 font-display text-2xl tracking-tight">Artemisia</p>
          <p class="mt-1 text-sm text-parchment-dim">Logiciel BTP, pas un agent</p>
        </li>
      </ul>
    </section>

    <section class="px-5 py-14 sm:px-8" aria-label="Repère stoïcien">
      <div class="mx-auto max-w-6xl">
        <Quote
          text="Ce n’est pas que nous ayons peu de temps : c’est que nous en perdons beaucoup."
          author="Sénèque"
          work="De la brièveté de la vie"
        />
      </div>
    </section>

    <section id="systeme" class="px-5 py-16 sm:px-8" aria-labelledby="systeme-title" data-reveal>
      <div class="mx-auto max-w-6xl">
        <p class="meta text-cyan-flux">02 — Système</p>
        <h2 id="systeme-title" class="display mt-4 max-w-3xl text-4xl text-balance sm:text-5xl">
          Un SI qui se connecte.
        </h2>
        <p class="mt-4 max-w-2xl text-parchment-dim">
          Les outils dispersés deviennent un parcours. Chaque étape a un responsable. L’agent prépare, il ne signe pas.
        </p>
        <ol class="flow-grid mt-10">
          {
            flows.map((item) => (
              <li class="flow-step">
                <p class="meta text-cyan-flux">{item.index}</p>
                <p class="mt-3 font-display text-2xl tracking-tight">{item.title}</p>
                <p class="mt-2 text-sm text-parchment-dim">{item.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section id="solutions" class="px-5 py-8 sm:px-8" aria-labelledby="solutions-title">
      <div class="mx-auto max-w-6xl">
        <p class="meta text-cyan-flux">03 — Solutions</p>
        <h2 id="solutions-title" class="display mt-4 max-w-3xl text-4xl text-balance sm:text-5xl">
          Des solutions concrètes.
        </h2>
        <div class="solution-grid mt-10">
          {
            solutions.map((item) => (
              <a class="solution-card" href={item.href}>
                <span class="icon-tile"><Icon name={item.icon} /></span>
                <span class="meta mt-6 text-cyan-flux">{item.kicker}</span>
                <span class="mt-2 font-display text-3xl tracking-tight">{item.title}</span>
                <span class="mt-3 block max-w-md text-sm">{item.text}</span>
                <span class="text-link mt-6">{item.action}</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section id="usages" class="px-5 py-16 sm:px-8" aria-labelledby="usages-title">
      <div class="mx-auto max-w-6xl">
        <p class="meta text-cyan-flux">04 — Cas d’usage</p>
        <h2 id="usages-title" class="display mt-4 max-w-3xl text-4xl text-balance sm:text-5xl">
          Ce que le système peut préparer.
        </h2>
        <p class="mt-4 max-w-2xl text-parchment-dim">
          Les cinq cartes sont des exemples. Elles ne décrivent pas un client nommé, ni un résultat chiffré.
        </p>
        <ul class="case-grid mt-10">
          {
            cases.map((item) => (
              <li>
                <a class="case-card block h-full" href={item.href}>
                  <p class="meta text-cyan-flux">{item.kicker}</p>
                  <p class="mt-3 font-display text-xl tracking-tight">{item.title}</p>
                  <p class="mt-2 text-sm text-parchment-dim">{item.text}</p>
                </a>
              </li>
            ))
          }
        </ul>
        <article class="case-card mt-4">
          <p class="meta text-cyan-flux">Projet livré</p>
          <h3 class="mt-3 font-display text-2xl tracking-tight">{artemisia.data.title}</h3>
          <p class="mt-2 max-w-3xl text-parchment-dim">{artemisia.data.summary} Ce n’est pas un agent.</p>
          <p class="mt-4">
            <a class="text-link" href="/realisations">Lire la réalisation</a>
          </p>
        </article>
        <div class="mt-12 glass-3 px-6 py-10 sm:px-10">
          <p class="meta text-cyan-flux">Votre tâche</p>
          <h3 class="display mt-4 max-w-3xl text-4xl text-balance">Quelle tâche vous fait perdre du temps ?</h3>
          <div class="mt-8">
            <TaskMatcher client:visible />
          </div>
        </div>
      </div>
    </section>

    <section id="methode" class="px-5 py-8 sm:px-8" aria-labelledby="methode-title" data-reveal>
      <div class="mx-auto max-w-6xl">
        <p class="meta text-cyan-flux">05 — Méthode</p>
        <h2 id="methode-title" class="display mt-4 max-w-3xl text-4xl text-balance sm:text-5xl">
          Cinq temps, un responsable.
        </h2>
        <ol class="method-line mt-10">
          {
            method.map((step) => (
              <li class="method-step">
                <span class="method-index">{step.index}</span>
                <div>
                  <p class="font-display text-2xl tracking-tight">{step.title}</p>
                  <p class="mt-2 text-sm text-parchment-dim">{step.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <p class="mt-8">
          <a class="text-link" href="/methode">Lire la méthode</a>
        </p>
      </div>
    </section>

    <section id="contact" class="px-5 py-16 sm:px-8" aria-labelledby="contact-title">
      <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="meta text-cyan-flux">Contact</p>
          <h2 id="contact-title" class="display mt-4 text-4xl text-balance sm:text-5xl">
            Parlons de votre projet.
          </h2>
          <p class="mt-4 max-w-md text-parchment-dim">
            Décrivez la tâche. Nous répondons sous {site.response}. Le formulaire arrive dans une boîte réelle.
          </p>
          <ul class="mt-6 space-y-2 text-sm text-parchment-dim">
            <li><a class="text-link" href={`mailto:${site.email}`}>{site.email}</a></li>
            <li><a class="text-link" href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a></li>
            <li>{site.city} · {site.region}</li>
          </ul>
        </div>
        <div class="lg:col-span-7">
          <ContactForm client:visible />
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
