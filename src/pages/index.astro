---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Frame from '../components/Frame.astro';
import Constellation from '../components/islands/Constellation';
import Demos from '../components/islands/Demos';
import { site } from '../lib/site';

const home = await getEntry('home', 'page');
if (!home) throw new Error('Contenu d’accueil manquant');
const copy = home.data;

const agents = (await getCollection('agents')).sort((a, b) => a.data.order - b.data.order);
const demos = (await getCollection('demos')).sort((a, b) => a.data.order - b.data.order);
const method = await getEntry('method', 'parcours');
const security = await getEntry('security', 'garanties');
const linksEntry = await getEntry('constellation', 'liens');
const artemisia = await getEntry('realisations', 'artemisia');
if (!method || !security || !linksEntry || !artemisia) throw new Error('Contenu de section manquant');

const nodes = agents.map((agent) => ({
  id: agent.id,
  title: agent.data.navTitle,
  role: agent.data.role,
  short: agent.data.short,
  x: agent.data.x,
  y: agent.data.y,
  href: `/agents/${agent.id}`,
}));
const scenes = demos.map((demo) => ({ id: demo.id, ...demo.data }));
---

<Base
  title="Atomixia — Des agents IA pour le travail qui se répète"
  description={site.description}
  path="/"
>
  <Header />
  <main id="contenu">
    <section class="px-5 pt-24 pb-8 sm:px-8 lg:pt-28" aria-labelledby="hero-title">
      <div class="mx-auto grid max-w-6xl items-end gap-8 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-6 lg:row-start-1">
          <p class="meta">{copy.hero.kicker}</p>
          <h1 id="hero-title" class="display mt-5 text-[clamp(2.55rem,6.2vw,5.4rem)] text-pretty">
            {copy.hero.title}
          </h1>
          <hr class="gold-rule" />
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a class="btn btn-gold" href="/contact">{copy.hero.primary}</a>
            <a class="btn btn-ghost" href="/agents">{copy.hero.secondary}</a>
          </div>
        </div>
        <div class="lg:col-span-6 lg:row-span-2 lg:row-start-1">
          <Constellation
            client:visible
            nodes={nodes}
            links={linksEntry.data.links}
            hint={copy.constellation.hint}
            instanceId="hero"
            variant="compact"
          />
        </div>
        <div class="lg:col-span-6 lg:row-start-2">
          <p class="max-w-xl text-lg text-parchment-dim">{copy.hero.subtitle}</p>
          <p class="editorial mt-6 max-w-lg">{copy.hero.editorial}</p>
        </div>
      </div>
    </section>

    <section aria-label="Repères" class="px-5 sm:px-8">
      <ul class="mx-auto grid max-w-6xl border-y border-gold-500/25 md:grid-cols-3 md:divide-x md:divide-gold-500/25">
        {
          copy.context.map((item) => (
            <li class="border-b border-gold-500/20 px-1 py-6 last:border-b-0 md:border-b-0 md:px-8">
              <p class="meta">{item.label}</p>
              <p class="mt-2 font-display text-2xl tracking-tight">{item.value}</p>
              <p class="mt-1 text-sm text-parchment-dim">{item.detail}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="probleme" class="px-5 py-24 sm:px-8" aria-labelledby="probleme-title" data-reveal>
      <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="meta">{copy.problem.kicker}</p>
          <h2 id="probleme-title" class="display mt-4 text-4xl sm:text-5xl">{copy.problem.title}</h2>
          <hr class="gold-rule" />
          <p class="editorial mt-8">{copy.problem.editorial}</p>
        </div>
        <ol class="lg:col-span-6 lg:col-start-7">
          {
            copy.problem.items.map((item, index) => (
              <li class="grid grid-cols-[3.5rem_1fr] gap-4 border-t border-parchment/10 py-5">
                <span class="meta text-gold-400">{String(index + 1).padStart(2, '0')}</span>
                <p class="text-lg">{item}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section id="constellation" class="px-5 py-8 sm:px-8 sm:py-16" aria-labelledby="constellation-title" data-reveal>
      <div class="mx-auto max-w-6xl">
        <p class="meta">{copy.constellation.kicker}</p>
        <h2 id="constellation-title" class="display mt-4 max-w-3xl text-4xl sm:text-5xl">{copy.constellation.title}</h2>
        <hr class="gold-rule" />
        <p class="editorial mt-8 max-w-xl">{copy.constellation.editorial}</p>
        <div class="mt-12">
          <Constellation
            client:visible
            nodes={nodes}
            links={linksEntry.data.links}
            hint={copy.constellation.hint}
            instanceId="carte"
            variant="full"
          />
        </div>
      </div>
    </section>

    <section id="demonstrations" class="px-5 py-16 sm:px-8" aria-labelledby="demos-title" data-reveal>
      <div class="mx-auto max-w-6xl">
        <p class="meta">{copy.demos.kicker}</p>
        <h2 id="demos-title" class="display mt-4 max-w-3xl text-4xl sm:text-5xl">{copy.demos.title}</h2>
        <hr class="gold-rule" />
        <p class="editorial mt-8 max-w-xl">{copy.demos.editorial}</p>
        <Demos client:visible scenes={scenes} />
      </div>
    </section>

    <section id="methode" class="px-5 py-20 sm:px-8" aria-labelledby="methode-title" data-reveal>
      <div class="mx-auto max-w-6xl">
        <div class="grid gap-10 lg:grid-cols-12">
          <div class="lg:col-span-5">
            <p class="meta">{copy.method.kicker}</p>
            <h2 id="methode-title" class="display mt-4 text-4xl sm:text-5xl">{copy.method.title}</h2>
            <hr class="gold-rule" />
            <p class="editorial mt-8">{copy.method.editorial}</p>
            <a class="btn btn-ghost mt-8" href="/methode">Lire la méthode</a>
          </div>
          <ol class="lg:col-span-6 lg:col-start-7">
            {
              method.data.steps.map((step) => (
                <li class="grid grid-cols-[4.5rem_1fr] gap-4 border-t border-parchment/10 py-6">
                  <span class="font-display text-2xl text-gold-400">{step.index}</span>
                  <div>
                    <h3 class="font-display text-2xl tracking-tight">{step.title}</h3>
                    <p class="mt-2 text-parchment-dim">{step.summary}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </section>

    <section id="securite" class="px-5 py-20 sm:px-8" aria-labelledby="securite-title" data-reveal>
      <div class="mx-auto max-w-6xl">
        <p class="meta">{copy.security.kicker}</p>
        <h2 id="securite-title" class="display mt-4 max-w-3xl text-4xl sm:text-5xl">{copy.security.title}</h2>
        <hr class="gold-rule" />
        <p class="editorial mt-8 max-w-xl">{copy.security.editorial}</p>
        <dl class="mt-12">
          {
            security.data.points.map((point) => (
              <div class="grid gap-2 border-t border-parchment/10 py-5 md:grid-cols-[14rem_1fr] md:gap-8">
                <dt class="meta text-gold-400">{point.label}</dt>
                <dd class="text-parchment-dim">{point.text}</dd>
              </div>
            ))
          }
        </dl>
        <a class="btn btn-ghost mt-8" href="/securite">Le cadre de sécurité</a>
      </div>
    </section>

    <section id="artemisia" class="px-5 py-20 sm:px-8" aria-labelledby="artemisia-title" data-reveal>
      <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="meta">{artemisia.data.kicker}</p>
          <h2 id="artemisia-title" class="display mt-4 text-5xl sm:text-7xl">{artemisia.data.title}</h2>
          <hr class="gold-rule" />
          <p class="editorial mt-8 max-w-xl">Livrer un produit, pas une promesse.</p>
          <div class="mt-8 max-w-2xl space-y-4 text-parchment-dim">
            {artemisia.data.body.slice(0, 2).map((paragraph) => <p>{paragraph}</p>)}
          </div>
          <a class="btn btn-ghost mt-8" href="/realisations">Voir la réalisation</a>
        </div>
        <div class="lg:col-span-5 lg:pt-16">
          <Frame>
            <div class="glass px-6 py-8">
              <p class="meta">À ne pas confondre</p>
              <p class="mt-4 font-display text-3xl tracking-tight">Pas un agent IA.</p>
              <p class="mt-4 text-parchment-dim">{artemisia.data.summary}</p>
            </div>
          </Frame>
        </div>
      </div>
    </section>

    <section id="diagnostic" class="px-5 py-12 sm:px-8" aria-labelledby="diagnostic-title" data-reveal>
      <div class="mx-auto max-w-6xl">
        <Frame>
          <div class="px-6 py-12 sm:px-12">
            <p class="meta">{copy.diagnostic.kicker}</p>
            <h2 id="diagnostic-title" class="display mt-4 max-w-3xl text-4xl sm:text-6xl">{copy.diagnostic.title}</h2>
            <hr class="gold-rule" />
            <p class="editorial mt-8 max-w-2xl">{copy.diagnostic.editorial}</p>
            <p class="mt-6 max-w-2xl text-parchment-dim">{copy.diagnostic.text}</p>
            {copy.diagnostic.price && <p class="meta mt-6 text-gold-300">{copy.diagnostic.price}</p>}
            <a class="btn btn-gold mt-8" href="/contact">{copy.diagnostic.cta}</a>
          </div>
        </Frame>
      </div>
    </section>

    <section id="contact" class="px-5 py-20 sm:px-8" aria-labelledby="contact-title" data-reveal>
      <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="meta">{copy.contact.kicker}</p>
          <h2 id="contact-title" class="display mt-4 text-4xl sm:text-5xl">{copy.contact.title}</h2>
          <hr class="gold-rule" />
          <p class="editorial mt-8">{copy.contact.editorial}</p>
          <p class="mt-6 max-w-xl text-parchment-dim">{copy.contact.text}</p>
          <a class="btn btn-gold mt-8" href="/contact#demande">Écrire</a>
        </div>
        <ul class="space-y-4 lg:col-span-4 lg:col-start-9 lg:pt-16">
          <li>
            <p class="meta">E-mail</p>
            <a class="mt-1 inline-flex text-parchment hover:text-gold-300" href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>
            <p class="meta">Téléphone</p>
            <a class="mt-1 inline-flex text-parchment hover:text-gold-300" href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a>
          </li>
          <li>
            <p class="meta">Zone</p>
            <p class="mt-1">{site.city} · {site.region}</p>
          </li>
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</Base>
