---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import Quote from '../components/Quote.astro';
import AgentTheater from '../components/islands/AgentTheater';
import IllustrationCarousel from '../components/islands/IllustrationCarousel';
import PhraseCycle from '../components/islands/PhraseCycle';
import TaskMatcher from '../components/islands/TaskMatcher';
import { homeSlides } from '../lib/illustrations';
import { site } from '../lib/site';

const artemisia = await getEntry('realisations', 'artemisia');
if (!artemisia) throw new Error('Réalisation manquante');

const usageGroups = (await getCollection('usages'))
  .filter((entry) => entry.id !== 'bibliotheque')
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({
    id: entry.id,
    label: entry.data.label,
    intro: entry.data.intro,
    cases: entry.data.cases.filter((item) => item.featured).sort((a, b) => a.order - b.order),
  }));

const shifts = [
  { from: 'Un système dispersé', to: 'Des accès et des traces clairs' },
  { from: 'Une tâche répétée', to: 'Un agent qui prépare' },
  { from: 'Une idée de logiciel', to: 'Un outil utilisable' },
  { from: 'Une pile de documents', to: 'Une réponse citée' },
];

const expertises = [
  {
    index: '01',
    name: 'Build',
    title: 'Construire',
    text: 'Sites, SaaS et applications métier, tenus par un usage réel.',
    tags: ['Sites web', 'SaaS', 'Applications', 'API'],
    href: '/sites',
    icon: 'layers' as const,
    span: 'bento-build',
  },
  {
    index: '02',
    name: 'Automate',
    title: 'Automatiser',
    text: 'Le geste qui se répète est préparé. Une personne valide.',
    tags: ['Workflows', 'Agents IA', 'Documents', 'Relances'],
    href: '/agents',
    icon: 'nodes' as const,
    span: 'bento-auto',
  },
  {
    index: '03',
    name: 'Secure',
    title: 'Sécuriser',
    text: 'Audit, tests et cadre d’accès. Le rapport dit quoi corriger.',
    tags: ['Pentest', 'Audit SI', 'Applicatif', 'Sensibilisation'],
    href: '/securite',
    icon: 'shield' as const,
    span: 'bento-secure',
  },
  {
    index: '04',
    name: 'Augment',
    title: 'Augmenter',
    text: 'Vos documents deviennent une base. La réponse cite la pièce.',
    tags: ['Connaissance', 'IA privée', 'Copilote', 'Recherche'],
    href: '/agents/connaissance',
    icon: 'core' as const,
    span: 'bento-augment',
  },
];

const pains = [
  { q: 'Je perds du temps à trier mes e-mails.', tags: ['Tri', 'Priorité', 'Brouillon'] },
  { q: 'Les mêmes tâches reviennent chaque semaine.', tags: ['Workflow', 'Agent', 'Échéance'] },
  { q: 'Je veux savoir si le système tient.', tags: ['Audit', 'Accès', 'Rapport'] },
  { q: 'J’ai une idée de logiciel à faire tenir.', tags: ['Architecture', 'Build', 'Mise en service'] },
];

const steps = [
  { index: '01', title: 'Découvrir', text: 'Comprendre le problème réel.' },
  { index: '02', title: 'Concevoir', text: 'Définir l’architecture.' },
  { index: '03', title: 'Construire', text: 'Livrer le système.' },
  { index: '04', title: 'Sécuriser', text: 'Tester avant d’ouvrir.' },
  { index: '05', title: 'Déployer', text: 'Mettre en service, puis suivre.' },
];
---

<Base title="Atomixia — Ingénierie numérique" description={site.description} path="/">
  <Header />
  <main id="contenu">
    <section class="hero-band px-5 pt-28 pb-8 sm:px-8" aria-labelledby="hero-title">
      <div class="mx-auto grid max-w-6xl items-center gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-5">
          <p class="meta text-cyan-flux">Atomixia · Ingénierie numérique</p>
          <h1 id="hero-title" class="display mt-5 text-[clamp(2.55rem,6.4vw,4.8rem)] text-balance">
            Des systèmes qui travaillent pour vous.
          </h1>
          <p class="mt-6 max-w-md text-lg text-parchment-dim">
            Nous concevons, automatisons et sécurisons vos logiciels. Vous gardez la décision.
          </p>
          <p class="phrase-line mt-4">
            <PhraseCycle
              client:visible
              phrases={['Un site qui explique.', 'Un agent qui prépare.', 'Une charte qui tient.', 'Un message qui arrive.']}
            />
            <span class="sr-only">Un site, un agent, une charte, un message qui arrive.</span>
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a class="btn btn-flux" href="/contact">Parlons de votre projet</a>
            <a class="btn btn-ghost" href="#expertises">Découvrir les expertises</a>
          </div>
        </div>
        <div class="lg:col-span-7">
          <IllustrationCarousel
            client:load
            slides={homeSlides}
            label="Atelier Atomixia : courrier, sites, système, charte, mobile et sécurité"
          />
        </div>
      </div>
    </section>

    <section aria-label="Repères" class="px-5 sm:px-8">
      <ul class="mx-auto grid max-w-6xl border-y border-white/10 md:grid-cols-3">
        <li class="border-b border-white/10 px-1 py-6 md:border-b-0 md:px-8">
          <p class="meta">Lieu</p>
          <p class="mt-2 font-display text-2xl tracking-tight">Lyon</p>
          <p class="mt-1 text-sm text-parchment-dim">{site.region}</p>
        </li>
        <li class="border-b border-white/10 px-1 py-6 md:border-b-0 md:border-l md:px-8">
          <p class="meta">Réponse</p>
          <p class="mt-2 font-display text-2xl tracking-tight">24 à 48 h</p>
          <p class="mt-1 text-sm text-parchment-dim">Après description du besoin</p>
        </li>
        <li class="px-1 py-6 md:border-l md:border-white/10 md:px-8">
          <p class="meta">Produit livré</p>
          <p class="mt-2 font-display text-2xl tracking-tight">Artemisia</p>
          <p class="mt-1 text-sm text-parchment-dim">Logiciel BTP, pas un agent</p>
        </li>
      </ul>
    </section>

    <section class="px-5 py-14 sm:px-8" aria-label="Repère stoïcien">
      <div class="mx-auto max-w-6xl">
        <Quote
          text="Ce n’est pas que nous ayons peu de temps : c’est que nous en perdons beaucoup."
          author="Sénèque"
          work="De la brièveté de la vie"
        />
      </div>
    </section>

    <section id="probleme" class="px-5 py-20 sm:px-8" aria-labelledby="probleme-title" data-reveal>
      <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="meta text-cyan-flux">01 — Problème</p>
          <h2 id="probleme-title" class="display mt-4 text-4xl text-balance sm:text-5xl">
            Le temps se perd sur ce qui se répète.
          </h2>
        </div>
        <ul class="lg:col-span-7">
          {
            pains.map((pain) => (
              <li class="border-t border-white/10 py-5">
                <p class="font-display text-xl tracking-tight sm:text-2xl">{pain.q}</p>
                <ul class="mt-3 flex flex-wrap gap-2">
                  {pain.tags.map((tag) => (
                    <li class="tag">{tag}</li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="solution" class="px-5 pb-8 sm:px-8" aria-labelledby="solution-title" data-reveal>
      <div class="mx-auto max-w-6xl">
        <p class="meta text-cyan-flux">02 — Solution</p>
        <h2 id="solution-title" class="display mt-4 max-w-3xl text-4xl text-balance sm:text-5xl">
          Atomixia transforme le travail en système.
        </h2>
        <ul class="mt-10 grid gap-3 sm:grid-cols-2">
          {
            shifts.map((shift) => (
              <li class="glass-1 px-5 py-6">
                <p class="text-sm text-parchment-dim">{shift.from}</p>
                <p class="mt-2 font-display text-2xl tracking-tight">{shift.to}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="expertises" class="px-5 py-20 sm:px-8" aria-labelledby="expertises-title">
      <div class="mx-auto max-w-6xl">
        <p class="meta text-cyan-flux">03 — Expertises</p>
        <h2 id="expertises-title" class="display mt-4 max-w-3xl text-4xl text-balance sm:text-5xl">
          Quatre gestes. Un même niveau d’exigence.
        </h2>
        <div class="bento mt-12">
          {
            expertises.map((item) => (
              <a class:list={['bento-card glass-2', item.span]} href={item.href} data-reveal>
                <span class="icon-tile"><Icon name={item.icon} /></span>
                <span class="mt-6 flex items-baseline justify-between gap-3">
                  <span class="meta text-cyan-flux">{item.index}</span>
                  <span class="meta">{item.name}</span>
                </span>
                <span class="mt-3 block font-display text-3xl tracking-tight">{item.title}</span>
                <span class="mt-3 block max-w-sm text-sm text-parchment-dim">{item.text}</span>
                <ul class="mt-5 flex flex-wrap gap-2">
                  {item.tags.map((tag) => (
                    <li class="tag">{tag}</li>
                  ))}
                </ul>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section id="en-action" class="px-5 py-16 sm:px-8" aria-labelledby="action-title">
      <div class="mx-auto max-w-6xl">
        <p class="meta text-cyan-flux">En action</p>
        <h2 id="action-title" class="display mt-4 max-w-3xl text-4xl text-balance sm:text-5xl">
          Une tâche. Un agent. Un résultat.
        </h2>
        <p class="mt-4 max-w-xl text-sm text-parchment-dim">
          Les nombres sont ceux de la scène. Ils ne mesurent pas l’activité d’Atomixia.
        </p>
        <div class="mt-10">
          <AgentTheater client:visible groups={usageGroups} />
        </div>
        <p class="mt-8">
          <a class="text-link" href="/usages">Toute la bibliothèque d’usages</a>
        </p>
      </div>
    </section>

    <section id="tache" class="px-5 pb-16 sm:px-8" aria-labelledby="tache-title">
      <div class="mx-auto max-w-6xl glass-3 px-6 py-10 sm:px-10">
        <p class="meta text-cyan-flux">Votre tâche</p>
        <h2 id="tache-title" class="display mt-4 max-w-3xl text-4xl text-balance sm:text-5xl">
          Quelle tâche vous fait perdre du temps ?
        </h2>
        <p class="mt-4 max-w-xl text-parchment-dim">Donnez-la à un agent.</p>
        <div class="mt-10">
          <TaskMatcher client:visible />
        </div>
      </div>
    </section>

    <section id="methode" class="px-5 py-16 sm:px-8" aria-labelledby="methode-title" data-reveal>
      <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="meta text-cyan-flux">Parcours</p>
          <h2 id="methode-title" class="display mt-4 text-4xl text-balance sm:text-5xl">Du problème au système en service.</h2>
          <a class="text-link mt-8" href="/methode">Lire la méthode</a>
        </div>
        <ol class="process lg:col-span-7 lg:col-start-6">
          {
            steps.map((step) => (
              <li>
                <span class="meta text-cyan-flux">{step.index}</span>
                <h3 class="mt-1 font-display text-2xl tracking-tight">{step.title}</h3>
                <p class="mt-1 text-sm text-parchment-dim">{step.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section id="preuve" class="px-5 py-16 sm:px-8" aria-labelledby="preuve-title" data-reveal>
      <div class="mx-auto grid max-w-6xl items-end gap-8 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="meta text-cyan-flux">Preuve</p>
          <h2 id="preuve-title" class="display mt-4 text-4xl text-balance sm:text-5xl">Des systèmes conçus pour durer.</h2>
          <p class="mt-5 max-w-xl text-parchment-dim">
            {artemisia.data.summary} Les noms de clients et les volumes d’usage ne sont pas publiés.
          </p>
          <a class="text-link mt-6" href="/realisations">Voir Artemisia</a>
        </div>
        <ul class="grid gap-3 sm:grid-cols-3 lg:col-span-5">
          <li class="glass-1 px-4 py-5">
            <p class="meta">Fondateur</p>
            <p class="mt-2 font-display text-xl tracking-tight">{site.founder}</p>
          </li>
          <li class="glass-1 px-4 py-5">
            <p class="meta">Atelier</p>
            <p class="mt-2 font-display text-xl tracking-tight">{site.city}</p>
          </li>
          <li class="glass-1 px-4 py-5">
            <p class="meta">Délai</p>
            <p class="mt-2 font-display text-xl tracking-tight">{site.response}</p>
          </li>
        </ul>
      </div>
    </section>

    <section class="px-5 py-16 sm:px-8" aria-labelledby="final-cta">
      <div class="final-cta mx-auto max-w-6xl px-6 py-14 text-center sm:px-12 sm:py-20">
        <h2 id="final-cta" class="display mx-auto max-w-3xl text-4xl text-balance sm:text-6xl">
          Votre prochain système commence ici.
        </h2>
        <a class="btn btn-flux mt-8" href="/contact">Parlons de votre projet</a>
      </div>
    </section>
  </main>
  <Footer />
</Base>
