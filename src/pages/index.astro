---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Quote from '../components/Quote.astro';
import ClarityBoard from '../components/ClarityBoard.astro';
import NodeMap from '../components/NodeMap.astro';
import Stages from '../components/Stages.astro';
import Perimeter from '../components/Perimeter.astro';
import LightLine from '../components/LightLine.astro';
import WorkBoard from '../components/WorkBoard.astro';
import PlanetBadge from '../components/PlanetBadge.astro';
import ContactForm from '../components/islands/ContactForm';
import StellarScene from '../components/islands/StellarScene';
import SystemScene from '../components/islands/SystemScene';
import TaskMatcher from '../components/islands/TaskMatcher';
import { site } from '../lib/site';
import { services, serviceList } from '../lib/services';
import { architectureLinks, architectureNodes } from '../lib/maps';

const planets = serviceList.map((service) => ({
  id: service.id,
  index: service.index,
  label: service.label,
  summary: service.summary,
  href: service.href,
  tone: service.tone,
}));

const method = [
  { index: '01', title: 'Comprendre', text: 'Une semaine réelle : un mail, un devis, une pièce introuvable. On regarde avant d’écrire.' },
  { index: '02', title: 'Concevoir', text: 'Les étapes, les outils, les décisions. Ce qu’un système peut préparer, ce qu’une personne garde.' },
  { index: '03', title: 'Construire', text: 'Une première version limitée, utilisable, mise entre les mains de l’équipe.' },
  { index: '04', title: 'Intégrer', text: 'Messagerie, dossiers, suivi, facturation : l’existant est relié, pas remplacé.' },
  { index: '05', title: 'Mesurer', text: 'Le journal des actions se relit. Ce qui a été préparé, ce qui a été validé.' },
  { index: '06', title: 'Améliorer', text: 'Ce qui coince vraiment est traité en premier. Si le métier change, le périmètre bouge.' },
];

const title = 'Atomixia — Vos systèmes méritent de devenir intelligents';
---

<Base title={title} description={site.description} path="/">
  <Header />
  <main id="contenu">
    <section class="hero-stellar px-5 pb-10 sm:px-8" aria-labelledby="hero-title">
      <div class="mx-auto max-w-6xl">
        <div class="hero-copy mx-auto max-w-3xl text-center">
          <p class="meta text-gold-400">Ingénierie · IA · Automatisation · Cybersécurité</p>
          <h1 id="hero-title" class="display mt-6 text-[clamp(2.7rem,6vw,5.2rem)] text-balance">
            Vos systèmes méritent de devenir <span class="gilt editorial-word">intelligents.</span>
          </h1>
          <p class="mx-auto mt-5 max-w-2xl text-lg text-parchment-dim">
            Atomixia conçoit des logiciels sur mesure, des systèmes d’IA et des automatisations qui améliorent concrètement votre façon de
            travailler.
          </p>
          <div class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <a class="btn btn-gold" href="/contact" data-cursor="Écrire">Parlons de votre projet</a>
            <a class="btn btn-ghost" href="#univers" data-cursor="Descendre">Explorer notre univers</a>
          </div>
          <p class="meta mt-8 text-subtle">{site.signature}</p>
        </div>
        <div class="mt-7" id="univers">
          <StellarScene client:load planets={planets} caption="Lyon · 45°45′ N" />
        </div>
      </div>
    </section>

    <section aria-label="Repères" class="px-5 sm:px-8">
      <ul class="mx-auto grid max-w-6xl border-y border-white/10 md:grid-cols-3">
        <li class="border-b border-white/10 px-1 py-6 md:border-b-0 md:px-8">
          <p class="meta">Lieu</p>
          <p class="mt-2 font-display text-2xl tracking-tight">Lyon</p>
          <p class="mt-1 text-sm text-parchment-dim">{site.region}</p>
        </li>
        <li class="border-b border-white/10 px-1 py-6 md:border-x md:border-b-0 md:border-white/10 md:px-8">
          <p class="meta">Réponse</p>
          <p class="mt-2 font-display text-2xl tracking-tight">24 à 48 h</p>
          <p class="mt-1 text-sm text-parchment-dim">Après description du besoin</p>
        </li>
        <li class="px-1 py-6 md:px-8">
          <p class="meta">Produit livré</p>
          <p class="mt-2 font-display text-2xl tracking-tight">Artemisia</p>
          <p class="mt-1 text-sm text-parchment-dim">Logiciel de gestion BTP</p>
        </li>
      </ul>
    </section>

    <section id="clarte" class="px-5 py-20 sm:px-8" aria-labelledby="clarte-title">
      <div class="mx-auto max-w-6xl">
        <div class="section-head">
          <div>
            <p class="section-index meta">02 — De la complexité à la clarté</p>
            <h2 id="clarte-title" class="display mt-4 text-4xl text-balance sm:text-5xl">Nous transformons la complexité en avantage.</h2>
          </div>
          <p class="text-parchment-dim">
            Les outils se sont ajoutés avec les années. Chacun a sa bonne raison. Ensemble, ils forment un système que personne ne décrit en
            entier. On le relie autour d’un centre, avec un responsable par étape.
          </p>
        </div>
        <div class="mt-12">
          <ClarityBoard />
        </div>
      </div>
    </section>

    <section class="px-5 pb-6 sm:px-8" aria-label="Repère stoïcien">
      <div class="mx-auto max-w-6xl">
        <Quote
          text="Ce n’est pas que nous ayons peu de temps : c’est que nous en perdons beaucoup."
          author="Sénèque"
          work="De la brièveté de la vie"
        />
      </div>
    </section>

    <section id="automatisation" class="px-5 py-20 sm:px-8 tone-cyan" aria-labelledby="automatisation-title">
      <div class="mx-auto max-w-6xl">
        <div class="section-head">
          <div>
            <p class="section-index meta">03 — {services.automation.label}</p>
            <h2 id="automatisation-title" class="display mt-4 text-4xl text-balance sm:text-5xl">
              Un agent prépare. <span class="text-cyan-flux">Une personne valide.</span>
            </h2>
          </div>
          <div>
            <p class="text-parchment-dim">{services.automation.lede}</p>
            <p class="mt-4"><a class="text-link" href={services.automation.href} data-cursor="Explorer">Voir l’automatisation IA</a></p>
          </div>
        </div>
        <div class="mt-12">
          <SystemScene client:visible />
        </div>
        <div class="mt-6 glass-3 px-6 py-10 sm:px-10">
          <p class="meta text-cyan-flux">Votre tâche</p>
          <h3 class="display mt-4 max-w-3xl text-3xl text-balance sm:text-4xl">Quelle tâche vous fait perdre du temps ?</h3>
          <div class="mt-8">
            <TaskMatcher client:visible />
          </div>
        </div>
      </div>
    </section>

    <section id="logiciel" class="px-5 py-20 sm:px-8 tone-gold" aria-labelledby="logiciel-title">
      <div class="mx-auto max-w-6xl">
        <div class="section-head">
          <div>
            <p class="section-index meta">04 — {services.software.label}</p>
            <h2 id="logiciel-title" class="display mt-4 text-4xl text-balance sm:text-5xl">
              Une architecture <span class="gilt">lisible</span>, de l’écran à la base.
            </h2>
          </div>
          <div>
            <p class="text-parchment-dim">
              Interface, API, logique métier, base de données, authentification, intégrations, supervision. Sept blocs qui se parlent.
              Survolez ou sélectionnez un bloc pour voir ce qu’il tient.
            </p>
            <p class="mt-4"><a class="text-link" href={services.software.href} data-cursor="Explorer">Voir les logiciels sur mesure</a></p>
          </div>
        </div>
        <div class="mt-12">
          <NodeMap
            id="archi-home"
            tone="gold"
            nodes={architectureNodes}
            links={architectureLinks}
            label="Blocs de l’architecture"
            intro="Les blocs sont ceux d’une application web type. Le découpage réel dépend du métier."
          />
        </div>
      </div>
    </section>

    <section id="conseil" class="px-5 py-20 sm:px-8 tone-silver" aria-labelledby="conseil-title">
      <div class="mx-auto max-w-6xl">
        <div class="section-head">
          <div>
            <p class="section-index meta">05 — {services.systems.label}</p>
            <h2 id="conseil-title" class="display mt-4 text-4xl text-balance sm:text-5xl">Une architecture qui sert votre stratégie.</h2>
          </div>
          <div>
            <p class="text-parchment-dim">{services.systems.summary} Cinq temps, du relevé à l’ajustement.</p>
            <p class="mt-4"><a class="text-link" href={services.systems.href} data-cursor="Explorer">Voir le conseil SI</a></p>
          </div>
        </div>
        <div class="mt-12">
          <Stages stages={services.systems.engagement.map((step, index) => ({ index: `0${index + 1}`, title: step.title.toUpperCase(), text: step.text }))} />
        </div>
      </div>
    </section>

    <section id="cyber" class="px-5 py-20 sm:px-8 tone-amber" aria-labelledby="cyber-title">
      <div class="mx-auto max-w-6xl">
        <div class="section-head">
          <div>
            <p class="section-index meta">06 — {services.cyber.label}</p>
            <h2 id="cyber-title" class="display mt-4 text-4xl text-balance sm:text-5xl">
              Identifiez les risques <span class="text-warning">avant</span> qu’ils ne deviennent des incidents.
            </h2>
          </div>
          <div>
            <p class="text-parchment-dim">{services.cyber.lede}</p>
            <p class="mt-4"><a class="text-link" href={services.cyber.href} data-cursor="Explorer">Voir la cybersécurité</a></p>
          </div>
        </div>
        <div class="mt-12">
          <Perimeter />
        </div>
      </div>
    </section>

    <section id="methode" class="px-5 py-20 sm:px-8" aria-labelledby="methode-title">
      <div class="mx-auto max-w-6xl">
        <div class="section-head">
          <div>
            <p class="section-index meta">07 — Méthode</p>
            <h2 id="methode-title" class="display mt-4 text-4xl text-balance sm:text-5xl">Six temps, une ligne de lumière.</h2>
          </div>
          <div>
            <p class="text-parchment-dim">La ligne avance avec vous. Chaque temps a un responsable et un livrable que l’on peut relire.</p>
            <p class="mt-4"><a class="text-link" href="/methode" data-cursor="Lire">Lire la méthode en détail</a></p>
          </div>
        </div>
        <div class="mt-14">
          <LightLine steps={method} />
        </div>
      </div>
    </section>

    <section id="realisations" class="px-5 py-20 sm:px-8" aria-labelledby="realisations-title">
      <div class="mx-auto max-w-6xl">
        <div class="section-head">
          <div>
            <p class="section-index meta">08 — Réalisations</p>
            <h2 id="realisations-title" class="display mt-4 text-4xl text-balance sm:text-5xl">Plusieurs systèmes, entre de vraies mains.</h2>
          </div>
          <p class="text-parchment-dim">
            Artemisia est le produit public. Autour, des automatisations, des logiciels et d’autres systèmes. Aucun client, aucun logo, aucun chiffre n’est inventé.
          </p>
        </div>
        <div class="mt-12">
          <WorkBoard />
        </div>
      </div>
    </section>

    <section id="contact" class="px-5 py-20 sm:px-8" aria-labelledby="contact-title">
      <div class="mx-auto max-w-6xl">
        <div class="cta-stellar">
          <div class="grid gap-10 lg:grid-cols-12">
            <div class="lg:col-span-5">
              <p class="meta text-gold-400">09 — Contact</p>
              <h2 id="contact-title" class="display mt-4 text-4xl text-balance sm:text-5xl">
                Et si votre prochain avantage était déjà à portée de main ?
              </h2>
              <p class="mt-5 max-w-md text-parchment-dim">
                Décrivez la tâche, l’outil ou le système. Nous répondons sous {site.response}. Le formulaire arrive dans une boîte réelle.
              </p>
              <ul class="mt-6 space-y-2 text-sm text-parchment-dim">
                <li><a class="text-link" href={`mailto:${site.email}`}>{site.email}</a></li>
                <li><a class="text-link" href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a></li>
                <li>{site.city} · {site.region}</li>
              </ul>
              <div class="mt-10 hidden lg:block">
                <PlanetBadge kind="software" class="max-w-[14rem] !mx-0" />
              </div>
            </div>
            <div class="lg:col-span-7">
              <ContactForm client:visible />
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
