---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const method = await getEntry('method', 'parcours');
if (!method) throw new Error('Méthode manquante');
const description =
  'Observer, cartographier, relier les outils, poser les garde-fous, superviser. La méthode Atomixia pour déployer un agent IA.';
---

<Base title="Méthode — Atomixia" description={description} path="/methode">
  <Header />
  <main id="contenu" class="px-5 pt-28 pb-24 sm:px-8">
    <article class="mx-auto max-w-6xl">
      <Breadcrumb items={[{ name: 'Accueil', href: '/' }, { name: 'Méthode', href: '/methode' }]} />
      <p class="meta mt-10">Cinq temps</p>
      <h1 class="display mt-4 max-w-4xl text-5xl sm:text-6xl">La méthode</h1>
      <hr class="gold-rule" />
      <p class="editorial mt-8 max-w-2xl">{method.data.editorial}</p>

      <ol class="mt-16">
        {
          method.data.steps.map((step) => (
            <li class="grid gap-4 border-t border-parchment/10 py-10 lg:grid-cols-12">
              <p class="font-display text-4xl text-gold-400 lg:col-span-2">{step.index}</p>
              <div class="lg:col-span-4">
                <h2 class="font-display text-3xl tracking-tight">{step.title}</h2>
                <p class="mt-3 text-parchment">{step.summary}</p>
              </div>
              <p class="text-parchment-dim lg:col-span-6">{step.detail}</p>
            </li>
          ))
        }
      </ol>

      <section class="mt-8" aria-labelledby="appui">
        <h2 id="appui" class="display text-4xl">Ce qui reste en appui</h2>
        <hr class="gold-rule" />
        <div class="mt-10 grid gap-12 lg:grid-cols-2">
          {
            method.data.support.map((item) => (
              <div class="border-t border-gold-500/40 pt-6">
                <h3 class="font-display text-2xl tracking-tight">{item.title}</h3>
                <p class="mt-4 text-parchment-dim">{item.text}</p>
              </div>
            ))
          }
        </div>
      </section>

      <a class="btn btn-gold mt-16" href="/contact">Décrire mon processus</a>
    </article>
  </main>
  <Footer />
</Base>
