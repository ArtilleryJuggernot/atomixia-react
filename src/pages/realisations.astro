---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import WorkIcon from '../components/WorkIcon.astro';
import { works, type Work } from '../lib/works';

const projects = (await getCollection('realisations')).sort((a, b) => a.data.order - b.data.order);
const artemisia = projects.find((project) => project.id === 'artemisia');
if (!artemisia) throw new Error('Réalisation manquante');

const chapters: { id: string; index: string; title: string; lede: string; items: Work[] }[] = [
  {
    id: 'produit-public',
    index: '01',
    title: 'Produit public',
    lede: 'Le seul nom publié. Artemisia est le logiciel commercialisé par Atomixia.',
    items: works.filter((work) => work.status === 'public'),
  },
  {
    id: 'automatisations',
    index: '02',
    title: 'Automatisations',
    lede: 'L’agent prépare le geste qui revient. L’envoi, le paiement et la décision restent à une personne.',
    items: works.filter((work) => work.family === 'automation'),
  },
  {
    id: 'logiciels',
    index: '03',
    title: 'Logiciels',
    lede: 'Formes de SaaS et d’outil interne. Aucun second produit n’est nommé.',
    items: works.filter((work) => work.family === 'saas' && work.status !== 'public'),
  },
  {
    id: 'autres',
    index: '04',
    title: 'Autres systèmes',
    lede: 'Relier les outils déjà là, écrire la carte, tester dans un cadre, expliquer l’activité.',
    items: works.filter((work) => work.family === 'other'),
  },
];

const description =
  'Artemisia, logiciel BTP commercialisé par Atomixia, puis des exemples d’automatisation, de logiciel et d’autres systèmes. Aucune référence client inventée.';
---

<Base title="Réalisations — Atomixia" description={description} path="/realisations">
  <Header />
  <main id="contenu" class="px-5 pt-28 pb-24 sm:px-8">
    <div class="mx-auto max-w-6xl">
      <Breadcrumb items={[{ name: 'Accueil', href: '/' }, { name: 'Réalisations', href: '/realisations' }]} />
      <p class="meta mt-10">Quatre chapitres</p>
      <h1 class="display mt-4 max-w-4xl text-5xl text-balance sm:text-6xl">Réalisations</h1>
      <hr class="gold-rule" />
      <p class="editorial mt-8 max-w-2xl">Montrer ce qui existe, et les formes de travail autour.</p>
      <p class="mt-4 max-w-2xl text-parchment-dim">
        Artemisia est le produit public. Les autres entrées sont des exemples d’automatisation, de SaaS et de système. Les noms de clients, logos et chiffres d’usage ne sont pas publiés.
      </p>

      <nav class="work-jump" aria-label="Sur cette page">
        {
          chapters.map((chapter) => (
            <a href={`#${chapter.id}`}>{chapter.title}</a>
          ))
        }
      </nav>

      {
        chapters.map((chapter) => (
          <section class="work-chapter" id={chapter.id} aria-labelledby={`${chapter.id}-title`}>
            <header>
              <p class="meta text-gold-400">{chapter.index}</p>
              <h2 id={`${chapter.id}-title`} class="display mt-3 text-4xl sm:text-5xl">{chapter.title}</h2>
              <p class="mt-4 max-w-2xl text-parchment-dim">{chapter.lede}</p>
            </header>

            {
              chapter.id === 'produit-public' ? (
                <article class="work-public panel mt-8" aria-labelledby="projet-artemisia">
                  <div>
                    <span class="work-ico" aria-hidden="true">
                      <WorkIcon id="artemisia" />
                    </span>
                    <p class="meta mt-4 text-gold-400">{artemisia.data.kicker}</p>
                    <h3 id="projet-artemisia" class="display mt-3 text-5xl sm:text-6xl">{artemisia.data.title}</h3>
                    <div class="mt-6 space-y-4 text-parchment-dim">
                      {artemisia.data.body.map((paragraph) => <p>{paragraph}</p>)}
                    </div>
                    <p class="mt-6">
                      <a class="text-link" href="/solutions/saas-logiciels">Voir les logiciels</a>
                    </p>
                  </div>
                  <div>
                    <p class="meta">Produit public</p>
                    <p class="mt-4 text-lg">{artemisia.data.summary}</p>
                    <ul class="stack-list mt-6" aria-label="Pile technique">
                      {artemisia.data.stack.map((item) => <li class="tag">{item}</li>)}
                    </ul>
                    <p class="mt-6 text-sm text-parchment-dim">{artemisia.data.note}</p>
                  </div>
                </article>
              ) : (
                <ol class="work-entries">
                  {
                    chapter.items.map((work, index) => (
                      <li class:list={['work-entry', `tone-${work.tone}`]} id={work.id}>
                        <div class="work-entry-mark">
                          <span class="work-ico" aria-hidden="true">
                            <WorkIcon id={work.id} />
                          </span>
                          <span class="meta">{String(index + 1).padStart(2, '0')}</span>
                        </div>
                        <div class="min-w-0">
                          <p class="meta tone-text">{work.familyLabel} · {work.statusLabel}</p>
                          <h3 class="mt-2 font-display text-3xl tracking-tight">{work.title}</h3>
                          <p class="mt-3 text-parchment">{work.line}</p>
                        </div>
                        <div class="min-w-0">
                          <p class="text-parchment-dim">{work.text}</p>
                          <ul class="work-points mt-4">
                            {work.points.map((point) => <li>{point}</li>)}
                          </ul>
                          <p class="mt-4">
                            <a class="text-link" href={work.serviceHref}>{work.serviceCta}</a>
                          </p>
                        </div>
                      </li>
                    ))
                  }
                </ol>
              )
            }
          </section>
        ))
      }

      <a class="btn btn-gold mt-16" href="/contact">Parler d’un projet</a>
    </div>
  </main>
  <Footer />
</Base>
