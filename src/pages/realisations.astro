---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import WorkBoard from '../components/WorkBoard.astro';

const projects = (await getCollection('realisations')).sort((a, b) => a.data.order - b.data.order);
const description =
  'Artemisia, logiciel BTP commercialisé par Atomixia, et des exemples d’automatisation, de logiciel et de système. Les références non publiques ne sont pas inventées.';
---

<Base title="Réalisations — Atomixia" description={description} path="/realisations">
  <Header />
  <main id="contenu" class="px-5 pt-28 pb-24 sm:px-8">
    <div class="mx-auto max-w-6xl">
      <Breadcrumb items={[{ name: 'Accueil', href: '/' }, { name: 'Réalisations', href: '/realisations' }]} />
      <p class="meta mt-10">Projets publics</p>
      <h1 class="display mt-4 text-5xl sm:text-6xl">Réalisations</h1>
      <hr class="gold-rule" />
      <p class="editorial mt-8 max-w-2xl">Montrer ce qui existe, et les formes de travail autour.</p>
      <p class="mt-4 max-w-2xl text-parchment-dim">
        Artemisia est le seul produit nommé. Les autres cartes sont des exemples d’automatisation, de SaaS et de système. Les noms de clients, logos et chiffres d’usage ne sont pas publiés.
      </p>

      <div class="mt-12">
        <WorkBoard />
      </div>

      {
        projects.map((project) => (
          <article id={project.id === 'artemisia' ? 'produit-public' : undefined} class="mt-16 grid gap-10 lg:grid-cols-12" aria-labelledby={`projet-${project.id}`}>
            <div class="lg:col-span-7">
              <p class="meta">{project.data.kicker}</p>
              <h2 id={`projet-${project.id}`} class="display mt-4 text-6xl sm:text-7xl">{project.data.title}</h2>
              <hr class="gold-rule" />
              <div class="mt-8 space-y-4 text-parchment-dim">
                {project.data.body.map((paragraph) => <p>{paragraph}</p>)}
              </div>
              <p class="meta mt-8">{project.data.stack.join(' · ')}</p>
            </div>
            <div class="lg:col-span-5">
              <div class="panel px-6 py-8">
                <p class="meta">Produit public</p>
                <p class="mt-4 text-lg">{project.data.summary}</p>
                <p class="mt-6 text-sm text-parchment-dim">{project.data.note}</p>
              </div>
            </div>
          </article>
        ))
      }

      <a class="btn btn-gold mt-16" href="/contact">Parler d’un processus</a>
    </div>
  </main>
  <Footer />
</Base>
