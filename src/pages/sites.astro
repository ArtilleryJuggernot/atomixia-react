---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Frame from '../components/Frame.astro';
import Icon from '../components/Icon.astro';
import Quote from '../components/Quote.astro';
import Robot from '../components/Robot.astro';
import PhraseCycle from '../components/islands/PhraseCycle';
import { site } from '../lib/site';

const entry = await getEntry('sites', 'page');
if (!entry) throw new Error('Contenu sites manquant');
const data = entry.data;
const description =
  'Sites métier, logiciels SaaS et outils internes. Atomixia conçoit des présences et des produits utiles, depuis Lyon.';

const kit = [
  {
    icon: 'palette' as const,
    mark: '🎨',
    title: 'Charte graphique',
    text: 'Couleurs, caractères, filets. Assez de règles pour que chaque page appartienne au même système.',
  },
  {
    icon: 'mail' as const,
    mark: '✉️',
    title: 'Intégration e-mail',
    text: 'Le formulaire arrive dans une boîte réelle. Le message a un destinataire, pas un tiroir invisible.',
  },
  {
    icon: 'bot' as const,
    mark: '🤖',
    title: 'Système intelligent',
    text: 'Un agent peut préparer une réponse à partir des pages et des pièces. Une personne valide avant l’envoi.',
  },
  {
    icon: 'layout' as const,
    mark: '🗂️',
    title: 'Structure',
    text: 'Peu de pages. Chacune a un rôle : expliquer, prouver, ou permettre d’écrire.',
  },
  {
    icon: 'phone' as const,
    mark: '📱',
    title: 'Mobile',
    text: 'Le téléphone est le premier écran. Boutons larges, texte lisible, rien qui déborde.',
  },
  {
    icon: 'search' as const,
    mark: '🔎',
    title: 'Référencement',
    text: 'Titre, description, adresse canonique. Aucune promesse de place dans les résultats.',
  },
  {
    icon: 'pen' as const,
    mark: '✍️',
    title: 'Textes',
    text: 'Les phrases décrivent l’activité. Elles ne récitent pas un modèle.',
  },
  {
    icon: 'server' as const,
    mark: '🚀',
    title: 'Mise en ligne',
    text: 'Nom de domaine, hébergement et sauvegardes sont décidés avant le jour de la publication.',
  },
];

const trackIcon = {
  metier: 'layout',
  saas: 'server',
  relier: 'nodes',
} as const;

const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Sites métier et logiciels',
  serviceType: 'Conception de sites et de logiciels',
  description,
  url: new URL('/sites', site.url).toString(),
  provider: { '@id': `${site.url}/#organization` },
  areaServed: site.region,
};
const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: data.faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<Base title="Sites et logiciels — Atomixia" description={description} path="/sites" jsonLd={[service, faq]}>
  <Header />
  <main id="contenu" class="px-5 pt-28 pb-24 sm:px-8">
    <article class="mx-auto max-w-6xl">
      <Breadcrumb items={[{ name: 'Accueil', href: '/' }, { name: 'Sites', href: '/sites' }]} />
      <header class="mt-10 grid items-center gap-10 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="meta text-cyan-flux">Sites · Build</p>
          <h1 class="display mt-4 text-5xl text-balance sm:text-6xl">{data.title}</h1>
          <p class="phrase-line mt-6">
            <PhraseCycle
              client:visible
              phrases={['La charte est posée.', 'Le mail arrive.', 'L’agent prépare.', 'Le mobile tient.']}
            />
            <span class="sr-only">Charte, e-mail, agent et mobile font partie du même site.</span>
          </p>
          <p class="mt-5 max-w-xl text-lg text-parchment-dim">{data.editorial}</p>
        </div>
        <div class="site-stage lg:col-span-5">
          <span class="geo-ring" aria-hidden="true"></span>
          <span class="geo-diamond geo-diamond-lg" aria-hidden="true"></span>
          <Robot label="Robot en traits, au centre de la composition du site." />
          <p class="meta text-cyan-flux">Agent prêt</p>
        </div>
      </header>
      <p class="mt-10 max-w-3xl text-lg text-parchment-dim">{data.intro}</p>

      <section class="mt-14" aria-labelledby="kit-title">
        <h2 id="kit-title" class="display text-3xl sm:text-4xl">Tout est en place.</h2>
        <p class="mt-3 max-w-2xl text-parchment-dim">Ouvrez une ligne. Le détail dit ce que la mission couvre, et ce qu’elle ne promet pas.</p>
        <ul class="kit mt-8">
          {
            kit.map((item) => (
              <li>
                <details class="kit-item glass-2">
                  <summary>
                    <span class="icon-tile"><Icon name={item.icon} /></span>
                    <span class="min-w-0 font-display text-xl tracking-tight">
                      {item.title}
                      <span class="kit-mark" aria-hidden="true">{item.mark}</span>
                    </span>
                    <Icon name="check" />
                  </summary>
                  <p>{item.text}</p>
                </details>
              </li>
            ))
          }
        </ul>
      </section>

      <div class="mt-16 space-y-8">
        {
          data.tracks.map((track) => (
            <section id={track.id} class="offer-card glass-2 scroll-mt-28 px-6 py-8 sm:px-10" aria-labelledby={track.id + '-title'}>
              <div class="flex items-center justify-between gap-4">
                <p class="meta text-cyan-flux">{track.kicker}</p>
                <span class="icon-tile"><Icon name={trackIcon[track.id as keyof typeof trackIcon] ?? 'layers'} /></span>
              </div>
              <h2 id={track.id + '-title'} class="display mt-4 text-3xl sm:text-4xl">{track.title}</h2>
              <p class="mt-4 max-w-3xl text-parchment-dim">{track.text}</p>
              <ul class="mt-6 grid gap-3 sm:grid-cols-2">
                {track.points.map((point) => (
                  <li class="border-t border-cyan-flux/20 pt-3 text-sm">{point}</li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>

      <div class="mt-16 grid gap-8 lg:grid-cols-2">
        <Frame>
          <div class="px-6 py-8">
            <h2 class="font-display text-2xl tracking-tight">Ce que la mission comprend</h2>
            <ul class="mt-6 space-y-3">
              {data.included.map((item) => (
                <li class="border-t border-parchment/10 pt-3 text-parchment-dim">{item}</li>
              ))}
            </ul>
          </div>
        </Frame>
        <div class="px-6 py-8">
          <h2 class="font-display text-2xl tracking-tight">Ce qui n’est pas promis</h2>
          <ul class="mt-6 space-y-3">
            {data.limits.map((item) => (
              <li class="border-t border-gold-500/30 pt-3 text-parchment-dim">{item}</li>
            ))}
          </ul>
        </div>
      </div>

      <section class="mt-16" aria-labelledby="sites-faq">
        <h2 id="sites-faq" class="font-display text-3xl tracking-tight">Questions fréquentes</h2>
        <div class="mt-6 divide-y divide-parchment/10 border-y border-parchment/10">
          {
            data.faqs.map((item) => (
              <details class="group py-4">
                <summary class="cursor-pointer list-none font-display text-lg tracking-tight marker:content-none [&::-webkit-details-marker]:hidden">
                  <span class="flex items-start justify-between gap-6">
                    {item.question}
                    <span class="meta text-cyan-flux group-open:hidden" aria-hidden="true">Ouvrir</span>
                    <span class="meta hidden text-cyan-flux group-open:inline" aria-hidden="true">Fermer</span>
                  </span>
                </summary>
                <p class="mt-3 max-w-3xl text-parchment-dim">{item.answer}</p>
              </details>
            ))
          }
        </div>
      </section>

      <div class="mt-16">
        <Quote
          text="Le matin, lorsque tu as de la peine à te lever, aie cette pensée : je me lève pour faire l’œuvre d’un homme."
          author="Marc Aurèle"
          work="Pensées, livre V"
        />
      </div>

      <p class="mt-12">
        <a class="btn btn-flux" href="/contact">Parlons de votre projet</a>
      </p>
    </article>
  </main>
  <Footer />
</Base>
