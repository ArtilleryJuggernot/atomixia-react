---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Frame from '../components/Frame.astro';
import { site } from '../lib/site';

const entry = await getEntry('sites', 'page');
if (!entry) throw new Error('Contenu sites manquant');
const data = entry.data;
const description =
  'Sites métier, logiciels SaaS et outils internes. Atomixia conçoit des présences et des produits utiles, depuis Lyon.';

const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Sites métier et logiciels',
  serviceType: 'Conception de sites et de logiciels',
  description,
  url: new URL('/sites', site.url).toString(),
  provider: { '@id': `${site.url}/#organization` },
  areaServed: site.region,
};
const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: data.faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<Base title="Sites et logiciels — Atomixia" description={description} path="/sites" jsonLd={[service, faq]}>
  <Header />
  <main id="contenu" class="px-5 pt-28 pb-24 sm:px-8">
    <article class="mx-auto max-w-6xl">
      <Breadcrumb items={[{ name: 'Accueil', href: '/' }, { name: 'Sites', href: '/sites' }]} />
      <header class="mt-10 grid gap-8 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <p class="meta text-cyan-flux">Offre</p>
          <h1 class="display mt-4 text-5xl text-pretty sm:text-6xl">{data.title}</h1>
          <hr class="gold-rule" />
          <p class="editorial mt-8 max-w-2xl">{data.editorial}</p>
        </div>
      </header>
      <p class="mt-10 max-w-3xl text-lg text-parchment-dim">{data.intro}</p>

      <div class="mt-16 space-y-8">
        {
          data.tracks.map((track) => (
            <section id={track.id} class="offer-card glass scroll-mt-28 px-6 py-8 sm:px-10" aria-labelledby={track.id + '-title'}>
              <p class="meta text-cyan-flux">{track.kicker}</p>
              <h2 id={track.id + '-title'} class="display mt-4 text-3xl sm:text-4xl">{track.title}</h2>
              <p class="mt-4 max-w-3xl text-parchment-dim">{track.text}</p>
              <ul class="mt-6 grid gap-3 sm:grid-cols-2">
                {track.points.map((point) => (
                  <li class="border-t border-cyan-flux/20 pt-3 text-sm">{point}</li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>

      <div class="mt-16 grid gap-8 lg:grid-cols-2">
        <Frame>
          <div class="px-6 py-8">
            <h2 class="font-display text-2xl tracking-tight">Ce que la mission comprend</h2>
            <ul class="mt-6 space-y-3">
              {data.included.map((item) => (
                <li class="border-t border-parchment/10 pt-3 text-parchment-dim">{item}</li>
              ))}
            </ul>
          </div>
        </Frame>
        <div class="px-6 py-8">
          <h2 class="font-display text-2xl tracking-tight">Ce qui n’est pas promis</h2>
          <ul class="mt-6 space-y-3">
            {data.limits.map((item) => (
              <li class="border-t border-gold-500/30 pt-3 text-parchment-dim">{item}</li>
            ))}
          </ul>
        </div>
      </div>

      <section class="mt-16" aria-labelledby="sites-faq">
        <h2 id="sites-faq" class="font-display text-3xl tracking-tight">Questions fréquentes</h2>
        <div class="mt-6 divide-y divide-parchment/10 border-y border-parchment/10">
          {
            data.faqs.map((item) => (
              <details class="group py-4">
                <summary class="cursor-pointer list-none font-display text-lg tracking-tight marker:content-none [&::-webkit-details-marker]:hidden">
                  <span class="flex items-start justify-between gap-6">
                    {item.question}
                    <span class="meta text-cyan-flux group-open:hidden" aria-hidden="true">Ouvrir</span>
                    <span class="meta hidden text-cyan-flux group-open:inline" aria-hidden="true">Fermer</span>
                  </span>
                </summary>
                <p class="mt-3 max-w-3xl text-parchment-dim">{item.answer}</p>
              </details>
            ))
          }
        </div>
      </section>

      <p class="mt-12">
        <a class="btn btn-flux" href="/contact">Décrire mon besoin</a>
      </p>
    </article>
  </main>
  <Footer />
</Base>
